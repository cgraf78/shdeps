#!/usr/bin/env bash
# shellcheck disable=SC1091
# Regression coverage for interruption-safe release activation in install.sh.

set -uo pipefail

SHDEPS_DIR=$(cd "$(dirname "$0")/../.." && pwd)

# shellcheck source=helpers.sh
. "$(dirname "$0")/helpers.sh"

_real_cp=$(command -v cp)
_real_mkdir=$(command -v mkdir)
_real_mv=$(command -v mv)
_real_rm=$(command -v rm)
_real_stat=$(command -v stat)
_real_tar=$(command -v tar)
export SHDEPS_TEST_REAL_STAT="$_real_stat"
if command -v sha256sum >/dev/null 2>&1; then
  _real_hasher=$(command -v sha256sum)
  _real_hasher_is_shasum=0
else
  _real_hasher=$(command -v shasum)
  _real_hasher_is_shasum=1
fi

_write_fake_shdeps() {
  local path="$1" version="$2"

  cat >"$path" <<SH
#!/usr/bin/env bash
case "\${1:-}" in
  version) printf '%s\n' "shdeps $version" ;;
  __api)
    case "\${2:-}" in
      version) printf '%s\n' 'abi:1' ;;
      env-snapshot)
        printf '%s\n' \
          "install_dir=\${SHDEPS_INSTALL_DIR:-\$HOME/.local/share}" \
          "bin_dir=\${SHDEPS_BIN_DIR:-\$HOME/.local/bin}" \
          "git_dev_dir=\${SHDEPS_GIT_DEV_DIR:-\$HOME/git}" \
          'platform=linux' 'pkg_mgr=' \
          "force=\${SHDEPS_FORCE:-0}" \
          "reinstall=\${SHDEPS_REINSTALL:-0}"
        ;;
      link-extras | unlink-extras) ;;
    esac
    ;;
esac
SH
  chmod +x "$path"
}

_make_bundle() {
  local dir="$1" version="$2"

  mkdir -p "$dir"
  _write_fake_shdeps "$dir/shdeps" "$version"
  cp "$SHDEPS_DIR/shdeps.sh" "$dir/shdeps.sh"
  cp "$SHDEPS_DIR/install.sh" "$dir/install.sh"
  cat >"$dir/.shdeps-install.json" <<JSON
{"schema":1,"method":"release","artifact_platform":"test","version":"$version","tag":"$version","commit":"abcdef123456","repo":"cgraf78/shdeps"}
JSON
}

_platform_label() {
  local os arch android=0
  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  arch=$(uname -m | tr '[:upper:]' '[:lower:]')
  if [[ -n "${ANDROID_ROOT:-}" || -n "${TERMUX_VERSION:-}" || "$(uname -o 2>/dev/null)" == Android ]]; then
    android=1
  fi
  case "$arch" in
    amd64) arch=x86_64 ;;
    arm64) arch=aarch64 ;;
  esac
  case "$android:$os:$arch" in
    1:linux:aarch64) printf '%s\n' android-aarch64 ;;
    1:linux:x86_64) printf '%s\n' android-x86_64 ;;
    0:linux:x86_64) printf '%s\n' linux-x86_64-musl ;;
    0:linux:aarch64) printf '%s\n' linux-aarch64-musl ;;
    0:darwin:x86_64) printf '%s\n' macos-x86_64 ;;
    0:darwin:aarch64) printf '%s\n' macos-aarch64 ;;
    *) return 1 ;;
  esac
}

_directory_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null
}

_sha256_line() {
  local file="$1" name="$2"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | sed "s| .*$|  $name|"
  else
    shasum -a 256 "$file" | sed "s| .*$|  $name|"
  fi
}

_make_release() {
  local root="$1" bundle="$2" tag="$3" platform="$4"
  local archive="shdeps-${tag}-${platform}.tar.gz"

  mkdir -p "$root"
  tar -C "$bundle" -czf "$root/$archive" .
  _sha256_line "$root/$archive" "$archive" >"$root/$archive.sha256"
  cat >"$root/latest.json" <<JSON
{
  "tag_name": "$tag",
  "assets": [
    {"name": "$archive", "browser_download_url": "https://github.com/cgraf78/shdeps/releases/download/$tag/$archive"},
    {"name": "$archive.sha256", "browser_download_url": "https://github.com/cgraf78/shdeps/releases/download/$tag/$archive.sha256"}
  ]
}
JSON
}

_write_command_shims() {
  local bin="$1"

  mkdir -p "$bin"
  cat >"$bin/cp" <<'SH'
#!/usr/bin/env bash
set -u
dest=""
for arg in "$@"; do dest="$arg"; done
case "${SHDEPS_TEST_PHASE:-}:$dest" in
  staging-replacement:*/.shdeps-install.*/)
    staging="${dest%/}"
    printf '%s\n' "$staging" >"$SHDEPS_TEST_MARKERS/staging.path"
    "$SHDEPS_TEST_REAL_RM" -rf -- "$staging"
    "$SHDEPS_TEST_REAL_MKDIR" -p "$staging"
    printf '%s\n' foreign >"$staging/foreign"
    exit 74
    ;;
  copy:*/.shdeps-install.*/)
    printf '%s\n' "$$" >"$SHDEPS_TEST_MARKERS/worker.pid"
    printf '%s\n' "${dest%/}" >"$SHDEPS_TEST_MARKERS/staging.path"
    : >"$SHDEPS_TEST_MARKERS/ready"
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    while :; do sleep 1; done
    ;;
esac
"$SHDEPS_TEST_REAL_CP" "$@" || exit $?
