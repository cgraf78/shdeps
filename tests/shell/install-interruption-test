_write_driver() {
  local path="$1"

  cat >"$path" <<'SH'
#!/usr/bin/env bash
set -uo pipefail
if [[ "${SHDEPS_TEST_ERREXIT:-0}" == 1 ]]; then set -e; fi
if [[ "${SHDEPS_TEST_MONITOR:-0}" == 1 ]]; then set -m; fi
if [[ -n "${SHDEPS_TEST_UMASK:-}" ]]; then umask "$SHDEPS_TEST_UMASK"; fi

trap 'printf "caller-hup\n" >>"$SHDEPS_TEST_CALLER_SIGNALS"' HUP
trap 'printf "caller-int\n" >>"$SHDEPS_TEST_CALLER_SIGNALS"' INT
trap 'printf "caller-term\n" >>"$SHDEPS_TEST_CALLER_SIGNALS"' TERM
trap 'printf "caller-exit:%s\n" "$?" >>"$SHDEPS_TEST_CALLER_EXIT"' EXIT

before_hup=$(trap -p HUP)
before_int=$(trap -p INT)
before_term=$(trap -p TERM)
before_exit=$(trap -p EXIT)
before_flags=$-
before_options=$(set +o)
before_cwd=$PWD
before_umask=$(umask)

_test_wait_for_worker_not_running() {
  local wanted="" pid active attempt

  [[ -f "$SHDEPS_TEST_MARKERS/worker.pid" ]] && wanted=$(<"$SHDEPS_TEST_MARKERS/worker.pid")
  if [[ -z "$wanted" ]]; then
    : >"$SHDEPS_TEST_MARKERS/completion-timeout"
    return 1
  fi
  for ((attempt = 0; attempt < 250; attempt++)); do
    active=0
    jobs -pr >"$SHDEPS_TEST_MARKERS/jobs.running" || true
    while IFS= read -r pid; do
      [[ "$pid" == "$wanted" ]] && active=1
    done <"$SHDEPS_TEST_MARKERS/jobs.running"
    if [[ "$active" -eq 0 ]]; then
      : >"$SHDEPS_TEST_MARKERS/completion-observed"
      return 0
    fi
    sleep 0.01
  done
  : >"$SHDEPS_TEST_MARKERS/completion-timeout"
  return 1
}

SHDEPS_INSTALL_SH_NO_DISPATCH=1
export SHDEPS_INSTALL_SH_NO_DISPATCH
# shellcheck source=/dev/null
. "$SHDEPS_TEST_INSTALL_SH"
unset SHDEPS_INSTALL_SH_NO_DISPATCH

rc=0
case "$SHDEPS_TEST_MODE" in
  release) _install_release || rc=$? ;;
  bundle) _install_bundle "$SHDEPS_TEST_BUNDLE" || rc=$? ;;
  bootstrap) _bootstrap || rc=$? ;;
  latched)
    _install_test_blocker() {
      printf '%s\n' "$$" >"$SHDEPS_TEST_MARKERS/worker.pid"
      : >"$SHDEPS_TEST_MARKERS/blocker-started"
      trap 'exit 143' TERM
      while :; do sleep 1; done
    }
    _install_bundle_core() {
      _install_transaction_signal TERM
      _install_transaction_run _install_test_blocker
    }
    _install_transaction bundle || rc=$?
    ;;
  monitor)
    _install_bundle_core() {
      printf '%s\n' "$-" >"$SHDEPS_TEST_MARKERS/transaction.flags"
      _install_transaction_run true
    }
    _install_transaction bundle || rc=$?
    ;;
  teardown-signal)
    _install_bundle_core() { :; }
    eval "$(declare -f _install_transaction_restore_traps | sed '1s/_install_transaction_restore_traps/_install_transaction_restore_traps_original/')"
    _install_transaction_restore_traps() {
      _install_transaction_signal TERM
      _install_transaction_restore_traps_original
    }
    _install_transaction bundle || rc=$?
    ;;
  cleanup-interrupt)
    _install_bundle_core() {
      _install_private_directory "$_shdeps_tx_staging" || return 1
      _shdeps_tx_staging_identity=$(_install_directory_identity "$_shdeps_tx_staging") || return 1
      _shdeps_tx_staging_owned=1
      return 1
    }
    _install_transaction bundle || rc=$?
    ;;
  cleanup-unrelated-signal)
    trap ': >"$SHDEPS_TEST_MARKERS/usr1-seen"' USR1
    eval "$(declare -f _install_transaction_cleanup_run | sed '1s/_install_transaction_cleanup_run/_install_transaction_cleanup_run_original/')"
    _install_transaction_cleanup_run() {
      local cleanup_rc=0
      _install_transaction_cleanup_run_original "$@" || cleanup_rc=$?
      printf '%s\n' "$cleanup_rc" >"$SHDEPS_TEST_MARKERS/cleanup-run.rc"
      return "$cleanup_rc"
    }
    _install_bundle_core() {
      _install_private_directory "$_shdeps_tx_staging" || return 1
      _shdeps_tx_staging_identity=$(_install_directory_identity "$_shdeps_tx_staging") || return 1
      _shdeps_tx_staging_owned=1
      return 1
    }
    _install_transaction bundle || rc=$?
    ;;
  unrelated-signal)
    trap ': >"$SHDEPS_TEST_MARKERS/usr1-seen"' USR1
    _install_bundle_core() {
      _install_transaction_run sh -c '
        printf "%s\n" "$$" >"$SHDEPS_TEST_MARKERS/worker.pid"
        : >"$SHDEPS_TEST_MARKERS/ready"
        IFS= read -r _ <"$SHDEPS_TEST_MARKERS/unrelated.gate"
      '
    }
    _install_transaction bundle || rc=$?
    ;;
  unrelated-signal-completion)
    trap ': >"$SHDEPS_TEST_MARKERS/usr1-seen"; printf "release\n" >"$SHDEPS_TEST_MARKERS/completion.gate"; _test_wait_for_worker_not_running || true' USR1
    _install_bundle_core() {
      _install_transaction_run sh -c '
        printf "%s\n" "$$" >"$SHDEPS_TEST_MARKERS/worker.pid"
        : >"$SHDEPS_TEST_MARKERS/ready"
        IFS= read -r _ <"$SHDEPS_TEST_MARKERS/completion.gate"
      '
    }
    _install_transaction bundle || rc=$?
    ;;
esac

after_hup=$(trap -p HUP)
after_int=$(trap -p INT)
after_term=$(trap -p TERM)
after_exit=$(trap -p EXIT)
after_flags=$-
after_options=$(set +o)
after_cwd=$PWD
after_umask=$(umask)

{
  printf 'rc=%s\n' "$rc"
  [[ "$before_hup" == "$after_hup" ]] && printf 'hup=restored\n' || printf 'hup=changed\n'
  [[ "$before_int" == "$after_int" ]] && printf 'int=restored\n' || printf 'int=changed\n'
  [[ "$before_term" == "$after_term" ]] && printf 'term=restored\n' || printf 'term=changed\n'
  [[ "$before_exit" == "$after_exit" ]] && printf 'exit=restored\n' || printf 'exit=changed\n'
  [[ "$before_flags" == "$after_flags" ]] && printf 'flags=restored\n' || printf 'flags=changed\n'
  [[ "$before_options" == "$after_options" ]] && printf 'options=restored\n' || printf 'options=changed\n'
  [[ "$before_cwd" == "$after_cwd" ]] && printf 'cwd=restored\n' || printf 'cwd=changed\n'
  [[ "$before_umask" == "$after_umask" ]] && printf 'umask=restored\n' || printf 'umask=changed\n'
} >"$SHDEPS_TEST_REPORT"

exit "$rc"
SH
  chmod +x "$path"
}

_wait_for_file() {
  local path="$1" remaining=250
  while ((remaining > 0)); do
    [[ -e "$path" ]] && return 0
    sleep 0.02
    remaining=$((remaining - 1))
  done
  return 1
}

_wait_for_exit() {
  local pid="$1" remaining=250
  while ((remaining > 0)); do
    if ! kill -0 "$pid" 2>/dev/null; then return 0; fi
    sleep 0.02
    remaining=$((remaining - 1))
  done
  return 1
}

_tree_matches() {
  diff -r "$1" "$2" >/dev/null 2>&1
}

_report_is_restored() {
  local report="$1"
  [[ -f "$report" ]] || return 1
  [[ $(sed -n 's/=restored$//p' "$report" | wc -l | tr -d ' ') == 8 ]]
}

_run_interrupt_case() {
  local phase="$1" mode="$2" expected_tree="$3" signal="${4:-TERM}" errexit="${5:-0}" ignore_term="${6:-0}"
  local second_signal="${7:-}"
  local fresh="${8:-0}"
  local check_private="${9:-0}"
  local root live bundle snapshot release markers bin tmp report stdout stderr
  local caller_signals caller_exit driver install_script parent worker unrelated rc=0 timed_out=0
  local tag platform signal_status scratch="" staging="" backup=""
  local -a case_env

  root=$(_tmpdir)
  live="$root/live"
  bundle="$root/bundle"
  snapshot="$root/old-snapshot"
  release="$root/release"
  markers="$root/markers"
  bin="$root/bin"
  tmp="$root/tmp"
  report="$root/report"
  stdout="$root/stdout"
  stderr="$root/stderr"
