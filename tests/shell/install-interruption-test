    SHDEPS_TEST_REAL_MV="$_real_mv" \
    SHDEPS_TEST_REAL_RM="$_real_rm" \
    SHDEPS_TEST_REAL_TAR="$_real_tar" \
    SHDEPS_TEST_REPORT="$report" \
    "$driver" >/dev/null 2>"$root/stderr" &
  parent=$!
  if _wait_for_file "$markers/ready"; then
    kill -USR1 "$parent" 2>/dev/null || true
  else
    timed_out=1
  fi
  _wait_for_file "$markers/usr1-seen" || timed_out=1
  sleep 0.1
  if ! kill -0 "$parent" 2>/dev/null; then
    early_exit=1
  else
    printf 'release\n' >&9
  fi
  if ! _wait_for_exit "$parent"; then
    timed_out=1
    kill -KILL "$parent" 2>/dev/null || true
  fi
  wait "$parent" || rc=$?
  exec 9>&-

  [[ -f "$markers/worker.pid" ]] && worker=$(cat "$markers/worker.pid")
  [[ -f "$markers/staging.path" ]] && staging=$(cat "$markers/staging.path")
  _assert_eq 'cleanup unrelated signal: transaction keeps waiting' 0 "$early_exit"
  _assert_eq 'cleanup unrelated signal: original operation failure is preserved' 1 "$rc"
  _assert_eq 'cleanup unrelated signal: completion stays bounded' 0 "$timed_out"
  _assert_file_content 'cleanup unrelated signal: removal child success is preserved' \
