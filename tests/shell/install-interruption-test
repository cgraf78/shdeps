    SHDEPS_TEST_REAL_TAR="$_real_tar" \
    SHDEPS_TEST_REPORT="$report" \
    "$driver" >/dev/null 2>&1 || rc=$?

  _assert_eq 'allocation failure: install fails' 1 "$rc"
  if _report_is_restored "$report"; then
    _pass 'allocation failure: caller state restored'
  else
    _fail 'allocation failure: caller state restored'
  fi
  if _tree_matches "$snapshot" "$live"; then
    _pass 'allocation failure: old install remains byte-identical'
  else
    _fail 'allocation failure: old install remains byte-identical'
  fi
  [[ -f "$markers/staging.path" ]] && staging=$(cat "$markers/staging.path")
  _assert_not_exists 'allocation failure: unowned staging path is not removed or created' "$staging"
}

_run_executed_case() {
  local root live bundle snapshot markers bin stdout stderr parent worker rc=0 timed_out=0 staging=""

  root=$(_tmpdir)
  live="$root/live"
  bundle="$root/bundle"
  snapshot="$root/old-snapshot"
  markers="$root/markers"
  bin="$root/bin"
  stdout="$root/stdout"
  stderr="$root/stderr"
  mkdir -p "$markers"
  _make_bundle "$live" 20990101-020304-11111111
  _make_bundle "$bundle" 20990102-030405-22222222
  cp -R "$live" "$snapshot"
  _write_command_shims "$bin"

  PATH="$bin:$PATH" \
    SHDEPS_DIR="$live" \
    SHDEPS_BIN="$root/shdeps-bin" \
    SHDEPS_TEST_LIVE="$live" \
    SHDEPS_TEST_MARKERS="$markers" \
    SHDEPS_TEST_PHASE=copy \
    SHDEPS_TEST_REAL_CP="$_real_cp" \
    SHDEPS_TEST_REAL_MKDIR="$_real_mkdir" \
    SHDEPS_TEST_REAL_MV="$_real_mv" \
    SHDEPS_TEST_REAL_RM="$_real_rm" \
    SHDEPS_TEST_REAL_TAR="$_real_tar" \
    "$bundle/install.sh" >"$stdout" 2>"$stderr" &
  parent=$!
  if _wait_for_file "$markers/ready"; then
    kill -TERM "$parent" 2>/dev/null || true
  else
    timed_out=1
  fi
  if ! _wait_for_exit "$parent"; then
    timed_out=1
    if [[ -f "$markers/worker.pid" ]]; then
      worker=$(cat "$markers/worker.pid")
      kill -TERM "$worker" 2>/dev/null || true
    fi
    kill -KILL "$parent" 2>/dev/null || true
  fi
  wait "$parent" || rc=$?

  _assert_eq 'executed install: preserves TERM status' 143 "$rc"
  _assert_eq 'executed install: cancellation is bounded' 0 "$timed_out"
  if _tree_matches "$snapshot" "$live"; then
    _pass 'executed install: old install remains byte-identical'
  else
    _fail 'executed install: old install remains byte-identical'
  fi
  [[ -f "$markers/staging.path" ]] && staging=$(cat "$markers/staging.path")
  _assert_not_exists 'executed install: staging removed by EXIT-safe transaction' "$staging"
  if grep -Eq '^\[[0-9]+\][[:space:]]' "$stdout" "$stderr"; then
    _fail 'executed install: no job-control text leaks'
  else
    _pass 'executed install: no job-control text leaks'
  fi
}

