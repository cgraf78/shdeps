  cat >"$bin/stat" <<'SH'
#!/usr/bin/env bash
set -u
target=""
for arg in "$@"; do target="$arg"; done
case "${SHDEPS_TEST_PHASE:-}:$target" in
  staging-identity-failure:*/.shdeps-install.* | release-identity-failure:*/shdeps-release.*)
    printf '%s\n' "$target" >"$SHDEPS_TEST_MARKERS/identity.path"
    exit 77
    ;;
  backup-stat-failure:*.backup)
