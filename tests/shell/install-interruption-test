  if [[ -n "$worker" ]] && ! kill -0 "$worker" 2>/dev/null; then
    _pass 'cleanup unrelated signal: exact removal child is reaped'
  else
    _fail 'cleanup unrelated signal: exact removal child is reaped'
    [[ -n "$worker" ]] && kill -KILL "$worker" 2>/dev/null || true
  fi
  if _report_is_restored "$report"; then
    _pass 'cleanup unrelated signal: caller state restored'
  else
    _fail 'cleanup unrelated signal: caller state restored'
  fi
}

