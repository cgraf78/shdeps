  cat >"$bin/curl" <<'SH'
#!/usr/bin/env bash
set -u
out=""
url=""
config=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -w) shift 2 ;;
    -H) shift 2 ;;
    --config) config="$2"; shift 2 ;;
    -*) shift ;;
    *) url="$1"; shift ;;
  esac
done
if [[ "$config" == - ]]; then
  while IFS= read -r line; do
    case "$line" in
      'url = '* )
        url="${line#url = }"
        url="${url#\"}"
        url="${url%\"}"
        ;;
    esac
  done
fi
case "$url" in
  */latest)
    if [[ "${SHDEPS_TEST_PHASE:-}" == scratch-replacement ]]; then
      scratch="${out%/*}"
      printf '%s\n' "$scratch" >"$SHDEPS_TEST_MARKERS/scratch.path"
      "$SHDEPS_TEST_REAL_RM" -rf -- "$scratch"
      "$SHDEPS_TEST_REAL_MKDIR" -p "$scratch"
      printf '%s\n' foreign >"$scratch/foreign"
      exit 75
    fi
    "$SHDEPS_TEST_REAL_CP" "$SHDEPS_TEST_RELEASE/latest.json" "$out"
    ;;
  *.tar.gz)
    "$SHDEPS_TEST_REAL_CP" "$SHDEPS_TEST_RELEASE/$(basename "$url")" "$out" || exit $?
    if [[ "${SHDEPS_TEST_PHASE:-}" == *download* ]]; then
      printf '%s\n' "$$" >"$SHDEPS_TEST_MARKERS/worker.pid"
      printf '%s\n' "${out%/*}" >"$SHDEPS_TEST_MARKERS/scratch.path"
      : >"$SHDEPS_TEST_MARKERS/ready"
      trap 'exit 129' HUP
      trap 'exit 130' INT
      if [[ "${SHDEPS_TEST_IGNORE_TERM:-0}" == 1 ]]; then
        trap ': >"$SHDEPS_TEST_MARKERS/term-forwarded"' TERM
        while :; do sleep 0.02; done
      else
        trap 'exit 143' TERM
        while :; do sleep 1; done
      fi
    fi
    ;;
  *.sha256) "$SHDEPS_TEST_REAL_CP" "$SHDEPS_TEST_RELEASE/$(basename "$url")" "$out" ;;
  *) printf 'unexpected test URL: %s\n' "$url" >&2; exit 2 ;;
esac
SH

  cat >"$bin/sha256sum" <<'SH'
#!/usr/bin/env bash
set -u
last=""
for arg in "$@"; do last="$arg"; done
if [[ "${SHDEPS_TEST_PHASE:-}" == checksum ]]; then
  scratch="$PWD"
  case "$last" in */*) scratch="${last%/*}" ;; esac
  printf '%s\n' "$$" >"$SHDEPS_TEST_MARKERS/worker.pid"
  printf '%s\n' "$scratch" >"$SHDEPS_TEST_MARKERS/scratch.path"
  exec 3<>"$SHDEPS_TEST_CHECKSUM_GATE"
  : >"$SHDEPS_TEST_MARKERS/ready"
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  IFS= read -r _ <&3
fi
if [[ "$SHDEPS_TEST_REAL_HASHER_IS_SHASUM" == 1 ]]; then
  exec "$SHDEPS_TEST_REAL_HASHER" -a 256 "$@"
fi
exec "$SHDEPS_TEST_REAL_HASHER" "$@"
SH

  cat >"$bin/tar" <<'SH'
#!/usr/bin/env bash
set -u
"$SHDEPS_TEST_REAL_TAR" "$@" || exit $?
if [[ "${SHDEPS_TEST_PHASE:-}" == extract && "${1:-}" == -xzf ]]; then
  archive="$2"
  printf '%s\n' "$$" >"$SHDEPS_TEST_MARKERS/worker.pid"
  printf '%s\n' "${archive%/*}" >"$SHDEPS_TEST_MARKERS/scratch.path"
  : >"$SHDEPS_TEST_MARKERS/ready"
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  while :; do sleep 1; done
fi
SH

  cat >"$bin/mv" <<'SH'
#!/usr/bin/env bash
set -u
src="$1"
dest="$2"
phase=${SHDEPS_TEST_PHASE:-}

case "$phase" in
  restore-failure)
    case "$src:$dest" in
      *.backup:"$SHDEPS_TEST_LIVE")
        printf '%s\n' "$src" >"$SHDEPS_TEST_MARKERS/backup.path"
        : >"$SHDEPS_TEST_MARKERS/restore-failed"
        exit 72
        ;;
      */.shdeps-install.*:"$SHDEPS_TEST_LIVE") exit 71 ;;
    esac
    ;;
  restore-race)
    case "$src:$dest" in
      *.backup:"$SHDEPS_TEST_LIVE")
        "$SHDEPS_TEST_REAL_MKDIR" -p "$SHDEPS_TEST_LIVE"
        printf '%s\n' foreign >"$SHDEPS_TEST_LIVE/foreign"
        printf '%s\n' "$SHDEPS_TEST_LIVE/${src##*/}" >"$SHDEPS_TEST_MARKERS/recovery.path"
        ;;
      */.shdeps-install.*:"$SHDEPS_TEST_LIVE") exit 71 ;;
    esac
    ;;
esac

case "$src:$dest" in
  "$SHDEPS_TEST_LIVE":*.backup)
    if [[ "$phase" == backup-move-failure ]]; then
      printf '%s\n' "$dest" >"$SHDEPS_TEST_MARKERS/backup.path"
      exit 72
    fi
    if [[ "$phase" == backup-race ]]; then
      "$SHDEPS_TEST_REAL_MKDIR" -p "$dest"
      printf '%s\n' foreign >"$dest/foreign"
      printf '%s\n' "$dest" >"$SHDEPS_TEST_MARKERS/backup.path"
    fi
    ;;
  */.shdeps-install.*:"$SHDEPS_TEST_LIVE")
    if [[ "$phase" == destination-race || "$phase" == destination-race-signal ]]; then
      "$SHDEPS_TEST_REAL_MKDIR" -p "$SHDEPS_TEST_LIVE"
      printf '%s\n' foreign >"$SHDEPS_TEST_LIVE/foreign"
      printf '%s\n' "$SHDEPS_TEST_LIVE/${src##*/}" >"$SHDEPS_TEST_MARKERS/nested-staging.path"
    fi
    if [[ "$phase" == backup-disappears ]]; then
      backup=$(cat "$SHDEPS_TEST_MARKERS/backup.path")
      "$SHDEPS_TEST_REAL_RM" -rf -- "$backup"
      exit 71
    fi
    ;;
esac

"$SHDEPS_TEST_REAL_MV" "$@" || exit $?
case "$src:$dest" in
  "$SHDEPS_TEST_LIVE":*.backup)
    printf '%s\n' "$dest" >"$SHDEPS_TEST_MARKERS/backup.path"
    if [[ "$phase" == backup-stat-failure ]]; then
      exit 78
    fi
    if [[ "$phase" == old-moved ]]; then
      : >"$SHDEPS_TEST_MARKERS/ready"
      kill -"${SHDEPS_TEST_SIGNAL:-TERM}" "$PPID"
    fi
    ;;
  */.shdeps-install.*:"$SHDEPS_TEST_LIVE")
    if [[ "$phase" == postmove-invalid && "$src" != *.backup ]]; then
      chmod -x "$SHDEPS_TEST_LIVE/shdeps"
    fi
    if [[ "$phase" == activated* ]]; then
      : >"$SHDEPS_TEST_MARKERS/ready"
      kill -"${SHDEPS_TEST_SIGNAL:-TERM}" "$PPID"
    fi
    if [[ "$phase" == destination-race-signal && "$src" != *.backup ]]; then
      kill -TERM "$PPID"
    fi
    ;;
esac
SH

  cat >"$bin/mkdir" <<'SH'
#!/usr/bin/env bash
set -u
target=""
for arg in "$@"; do
  case "$arg" in -*) ;; *) target="$arg" ;; esac
done
if [[ "${SHDEPS_TEST_PHASE:-}" == allocation-failure && "$target" == */.shdeps-install.* ]]; then
  printf '%s\n' "$target" >"$SHDEPS_TEST_MARKERS/staging.path"
  exit 73
fi
exec "$SHDEPS_TEST_REAL_MKDIR" "$@"
