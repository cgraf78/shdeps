_run_cleanup_unrelated_signal_case() {
  local root markers bin report driver install_script parent worker="" staging="" rc=0 early_exit=0 timed_out=0

  root=$(_tmpdir)
  markers="$root/markers"
  bin="$root/bin"
  report="$root/report"
  driver="$root/driver"
  install_script="$SHDEPS_DIR/install.sh"
  mkdir -p "$markers"
  mkfifo "$markers/cleanup.gate"
  # Keep both ends open in the harness so a regressed cleanup child cannot
  # make the release write block forever after it has already been killed.
  exec 9<>"$markers/cleanup.gate"
  _write_command_shims "$bin"
  _write_driver "$driver"

  PATH="$bin:$PATH" \
    SHDEPS_DIR="$root/live" \
    SHDEPS_TEST_CALLER_EXIT="$root/caller-exit" \
    SHDEPS_TEST_CALLER_SIGNALS="$root/caller-signals" \
