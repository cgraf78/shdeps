#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2030,SC2031,SC2329
# install-sh-test — focused tests for install.sh helper functions.
# SC2030/SC2031: command-substitution fixtures intentionally isolate exported
# bootstrap variables, while mocked helpers inspect their dynamic local scope.
# SC2329: subshell-local `uname` mocks are invoked indirectly by install.sh.
#
# install.sh is the curl-pipe bootstrap script; its helpers cannot be
# covered by the Rust test suite. This file sources install.sh in a
# controlled subshell (which is safe because the dispatch is guarded by a
# sourced-vs-executed check at the bottom of the script) and exercises the
# helpers directly. Test cases stay small and focused; behavioral coverage
# of the full install/bootstrap path lives in `scripts/smoke-install-bash32.sh`
# and the Rust integration suite.

set -euo pipefail

# Resolve the repo root from the test script's own location so the test
# can be invoked from any working directory. Inlined rather than wrapped
# in a helper because shellcheck (SC2218) sometimes false-positives on
# command-substitution call sites for top-level helpers.
_test_dir=$(
  src="${BASH_SOURCE[0]}"
  case "$src" in
    */*) dir="${src%/*}" ;;
    *) dir="." ;;
  esac
  cd -P -- "$dir" && pwd
)
_repo_root=$(cd -P -- "$_test_dir/../.." && pwd)

_pass_count=0
_fail_count=0

# The installer deliberately links to a physical Lua tree. Keep expected paths
# under the same canonicalization policy, including macOS's /var -> /private/var
# alias and the explicit symlink-parent fixture below.
_physical_dir() {
  (cd -P -- "$1" && pwd)
}

_pass() {
  printf '  PASS: %s\n' "$*"
  _pass_count=$((_pass_count + 1))
}

_fail() {
  printf '  FAIL: %s\n' "$*"
  _fail_count=$((_fail_count + 1))
}

_assert_true() {
  local label="$1"
  shift
  if "$@"; then
    _pass "$label"
  else
    _fail "$label (expected success; exit $?)"
  fi
}

_assert_false() {
  local label="$1"
  shift
  if "$@"; then
    _fail "$label (expected failure but command succeeded)"
  else
    _pass "$label"
  fi
}

_assert_eq() {
  local label="$1" expected="$2" actual="$3"
  if [[ "$expected" == "$actual" ]]; then
    _pass "$label"
  else
    _fail "$label (expected: $expected, actual: $actual)"
  fi
}

_assert_contains() {
  local label="$1" expected="$2" actual="$3"
  if [[ "$actual" == *"$expected"* ]]; then
    _pass "$label"
  else
    _fail "$label (expected to contain '$expected', got '$actual')"
  fi
}

# Source install.sh in this shell with the dispatch suppressed via the
# documented opt-out env var. The opt-out is necessary because
# `. install.sh --bootstrap` is a real invocation pattern that the
# script supports; the BASH_SOURCE-vs-$0 trick would silently disable
# bootstrap as well. With the env var set, sourcing only loads helper
# definitions.
SHDEPS_INSTALL_SH_NO_DISPATCH=1
export SHDEPS_INSTALL_SH_NO_DISPATCH
# shellcheck source=../install.sh
source "$_repo_root/install.sh"
unset SHDEPS_INSTALL_SH_NO_DISPATCH

_fixture_dir=$(mktemp -d)
trap 'rm -rf "$_fixture_dir"' EXIT

echo "=== install.sh: interrupted wait status recovery ==="

_completed_child_status=$(
  set +e
  _wait_call_count=0
  wait() {
    _wait_call_count=$((_wait_call_count + 1))
    if [[ "$_wait_call_count" -eq 1 ]]; then
      return 22
    fi
    return 127
  }
  _install_transaction_job_running() { return 1; }
  _shdeps_tx_child=999999
  _shdeps_tx_signal=0
  _install_transaction_wait_child
  printf '%s\n' "$?"
)
_assert_eq "wait recovery: preserves an ordinary completed child failure" \
  22 "$_completed_child_status"

_stale_child_signal=$(
  set +e
  _stale_kill_count=0
  wait() { return 0; }
  kill() {
    _stale_kill_count=$((_stale_kill_count + 1))
    return 0
  }
  _shdeps_tx_child=424242
  _shdeps_tx_signal=0
  set -T
  trap 'if [[ "$BASH_COMMAND" == "_shdeps_tx_child=\"\"" ]]; then
    trap - DEBUG
    _install_transaction_signal TERM
  fi' DEBUG
  _install_transaction_wait_child
  _stale_rc=$?
  trap - DEBUG
  set +T
  printf '%s:%s\n' "$_stale_rc" "$_stale_kill_count"
)
_assert_eq "wait recovery: signal after reap never targets stale child PID" \
  "143:0" "$_stale_child_signal"

_active_child_signal=$(
  sleep 60 &
  _active_pid=$!
  _active_kill_count=0
  kill() {
    _active_kill_count=$((_active_kill_count + 1))
    builtin kill "$@"
  }
  _shdeps_tx_child=$_active_pid
  _shdeps_tx_signal=0
  _install_transaction_signal TERM
  if builtin kill -0 "$_active_pid" 2>/dev/null; then
    builtin kill -KILL "$_active_pid" 2>/dev/null || true
  fi
  wait "$_active_pid" 2>/dev/null || true
  printf '%s:%s\n' "$_shdeps_tx_signal" "$_active_kill_count"
)
_assert_eq "wait recovery: latched signal wakes an active child" \
  "143:1" "$_active_child_signal"

_stopped_child_active=$(
  sleep 60 &
  _stopped_pid=$!
  builtin kill -STOP "$_stopped_pid"
  sleep 0.05
  if _install_transaction_job_running "$_stopped_pid"; then
    printf 'active\n'
  else
    printf 'missing\n'
  fi
  builtin kill -CONT "$_stopped_pid" 2>/dev/null || true
  builtin kill -KILL "$_stopped_pid" 2>/dev/null || true
  wait "$_stopped_pid" 2>/dev/null || true
)
_assert_eq "wait recovery: stopped child remains an active owned job" \
  "active" "$_stopped_child_active"

_signaled_child_status=$(
  set +e
  _wait_call_count=0
  wait() {
    _wait_call_count=$((_wait_call_count + 1))
    [[ "$_wait_call_count" -ne 1 ]] || return 143
    return 127
  }
  _install_transaction_job_running() { return 1; }
  _shdeps_tx_child=999998
  _shdeps_tx_signal=0
  _install_transaction_wait_child
  printf '%s:%s\n' "$?" "$_wait_call_count"
)
_assert_eq "wait recovery: genuine signal child status survives exhausted re-wait" \
  "143:2" "$_signaled_child_status"

_cleanup_signaled_status=$(
  set +e
  _wait_call_count=0
  wait() {
    _wait_call_count=$((_wait_call_count + 1))
    [[ "$_wait_call_count" -ne 1 ]] || return 143
    return 127
  }
  _install_transaction_job_running() { return 1; }
  _shdeps_tx_child=""
  _shdeps_tx_signal=0
  _install_transaction_cleanup_run :
  printf '%s:%s\n' "$?" "$_wait_call_count"
)
_assert_eq "wait recovery: cleanup preserves genuine signal child status" \
  "143:2" "$_cleanup_signaled_status"

echo "=== install.sh: ownership removal race ==="

_remove_race_root="$_fixture_dir/remove-race"
_remove_race_path="$_remove_race_root/owned"
_remove_race_saved="$_remove_race_root/original-owned"
_remove_race_report="$_remove_race_root/report"
mkdir -p "$_remove_race_root"
(
  _install_private_directory "$_remove_race_path" race-token
  printf 'owned\n' >"$_remove_race_path/owned"
  _remove_race_identity=$(
    _install_directory_identity "$_remove_race_path" race-token
  )
  _remove_race_injected=0
  _install_identity_matches() {
    local path="$1" expected="$2" actual=""
    actual=$(_install_directory_identity "$path" 2>/dev/null) || return 1
    [[ "$actual" == "$expected" ]] || return 1
    if [[ "$path" == "$_remove_race_path" && "$_remove_race_injected" -eq 0 ]]; then
      mv "$_remove_race_path" "$_remove_race_saved"
      mkdir "$_remove_race_path"
      printf 'foreign\n' >"$_remove_race_path/foreign"
      _remove_race_injected=1
    fi
  }
  _remove_race_rc=0
  _install_transaction_remove_owned \
    "$_remove_race_path" "race fixture" "$_remove_race_identity" normal ||
    _remove_race_rc=$?
  printf '%s:%s\n' "$_remove_race_rc" "$_remove_race_injected" \
    >"$_remove_race_report"
)
_assert_eq "ownership removal: replacement race is detected" \
  "1:1" "$(cat "$_remove_race_report")"
_assert_true "ownership removal: foreign replacement survives" \
  test -f "$_remove_race_path/foreign"
_assert_true "ownership removal: original owned tree is not confused with replacement" \
  test -f "$_remove_race_saved/owned"

echo "=== install.sh: suppressed bootstrap status diagnostics ==="

_bootstrap_status_out="$_fixture_dir/bootstrap-status.out"
_bootstrap_status_rc=0
(
  unset SHDEPS_LIB
  SHDEPS_GIT_DEV_DIR="$_fixture_dir/no-dev-clones"
  SHDEPS_DIR="$_fixture_dir/no-installed-tree"
  export SHDEPS_GIT_DEV_DIR SHDEPS_DIR
  _install() {
    _SHDEPS_INSTALL_PROPAGATION_MESSAGE="shdeps transaction cleanup requires manual recovery; retained state: $_fixture_dir/recovery"
    _error "$_SHDEPS_INSTALL_PROPAGATION_MESSAGE"
    return 125
  }
  _bootstrap
) >"$_bootstrap_status_out" 2>&1 || _bootstrap_status_rc=$?
_assert_eq "bootstrap status: hard cleanup failure is preserved" \
  125 "$_bootstrap_status_rc"
_assert_true "bootstrap status: suppressed recovery path is re-emitted" \
  grep -Fq "retained state: $_fixture_dir/recovery" "$_bootstrap_status_out"

echo "=== install.sh: bootstrap activation failure ==="

_bootstrap_link_dir="$_fixture_dir/bootstrap-link"
_bootstrap_link_out="$_fixture_dir/bootstrap-link.out"
mkdir -p "$_bootstrap_link_dir"
printf 'shdeps_update() { :; }\n' >"$_bootstrap_link_dir/shdeps.sh"
_bootstrap_retry_report=$(
  unset -f shdeps_update shdeps_self_update shdeps_link_extras 2>/dev/null || true
  unset _SHDEPS_BOOTSTRAP_READY_KEY SHDEPS_BOOTSTRAP_FORCE
  SHDEPS_LIB="$_bootstrap_link_dir/shdeps.sh"
  SHDEPS_DIR="$_fixture_dir/unrelated-install-root"
  export SHDEPS_LIB SHDEPS_DIR
  _setup_attempts=0
  _cleanup_attempts=0
  _setup_links() {
    _setup_attempts=$((_setup_attempts + 1))
    [[ "$_setup_attempts" -ne 1 ]] || return 77
  }
  _cleanup_installed_state_for_source_checkout() {
    _cleanup_attempts=$((_cleanup_attempts + 1))
  }
  _first_rc=0
  _second_rc=0
  _third_rc=0
  _fourth_rc=0
  _fifth_rc=0
  _bootstrap >"$_bootstrap_link_out" 2>&1 || _first_rc=$?
  _bootstrap >>"$_bootstrap_link_out" 2>&1 || _second_rc=$?
  _bootstrap >>"$_bootstrap_link_out" 2>&1 || _third_rc=$?
  SHDEPS_INSTALL_DIR="$_fixture_dir/alternate-install-root"
  export SHDEPS_INSTALL_DIR
  _bootstrap >>"$_bootstrap_link_out" 2>&1 || _fourth_rc=$?
  SHDEPS_STATE_DIR="$_fixture_dir/alternate-state-root"
  export SHDEPS_STATE_DIR
  _bootstrap >>"$_bootstrap_link_out" 2>&1 || _fifth_rc=$?
  SHDEPS_BOOTSTRAP_FORCE=1
  export SHDEPS_BOOTSTRAP_FORCE
  _sixth_rc=0
  _bootstrap >>"$_bootstrap_link_out" 2>&1 || _sixth_rc=$?
  printf '%s:%s:%s:%s:%s:%s:%s:%s\n' \
    "$_first_rc" "$_second_rc" "$_third_rc" "$_fourth_rc" "$_fifth_rc" "$_sixth_rc" \
    "$_setup_attempts" "$_cleanup_attempts"
)
_assert_eq "bootstrap activation: retries failures and invalidates readiness for force" \
  "77:0:0:0:0:0:5:4" "$_bootstrap_retry_report"

echo "=== install.sh: bootstrap self-update force scope ==="

_bootstrap_force_report=$(
  unset SHDEPS_FORCE
  SHDEPS_BOOTSTRAP_FORCE=1
  export SHDEPS_BOOTSTRAP_FORCE
  shdeps_self_update() {
    printf 'bootstrap:%s:%s\n' "$SHDEPS_DIR" "${SHDEPS_FORCE-unset}"
  }
  _bootstrap_self_update "$_fixture_dir/source-checkout"
  printf 'caller:%s\n' "${SHDEPS_FORCE-unset}"

  SHDEPS_BOOTSTRAP_FORCE=0
  SHDEPS_FORCE=1
  export SHDEPS_BOOTSTRAP_FORCE SHDEPS_FORCE
  _bootstrap_self_update "$_fixture_dir/source-checkout"
  printf 'caller:%s\n' "$SHDEPS_FORCE"
)
_assert_eq "bootstrap self-update: provider force is child-scoped and legacy force survives" \
  "bootstrap:$_fixture_dir/source-checkout:1
caller:unset
bootstrap:$_fixture_dir/source-checkout:1
caller:1" "$_bootstrap_force_report"

echo "=== install.sh: Lua API link ownership ==="

_lua_link_root="$_fixture_dir/lua-link"
_lua_physical_root="$_fixture_dir/lua-physical-root"
_lua_alias_root="$_fixture_dir/lua-alias-root"
mkdir -p "$_lua_physical_root"
ln -s "$_lua_physical_root" "$_lua_alias_root"
# Use a symlinked parent even on Linux so the physical-target contract and the
# macOS path spelling that exposed it remain covered on every platform.
_lua_source_one="$_lua_alias_root/lua-source-one"
_lua_source_two="$_lua_alias_root/lua-source-two"
mkdir -p \
  "$_lua_source_one/lua/shdeps" \
  "$_lua_source_two/lua/shdeps"
printf 'return {}\n' >"$_lua_source_one/lua/shdeps.lua"
printf 'return {}\n' >"$_lua_source_one/lua/shdeps/bootstrap.lua"
printf 'return {}\n' >"$_lua_source_two/lua/shdeps.lua"
printf 'return {}\n' >"$_lua_source_two/lua/shdeps/bootstrap.lua"

SHDEPS_LUA_DIR="$_lua_link_root"
export SHDEPS_LUA_DIR
_setup_links "$_lua_source_one"
_assert_true "Lua API link: activation creates the stable link" \
  test -L "$_lua_link_root"
_assert_eq "Lua API link: stable link selects the active Lua tree" \
  "$(_physical_dir "$_lua_source_one/lua")" "$(readlink "$_lua_link_root")"

_setup_links "$_lua_source_two"
_assert_eq "Lua API link: later activation retargets the managed link" \
  "$(_physical_dir "$_lua_source_two/lua")" "$(readlink "$_lua_link_root")"

rm -f "$_lua_link_root"
mkdir -p "$_lua_link_root"
printf 'keep\n' >"$_lua_link_root/owned-by-user"
_lua_foreign_rc=0
_setup_links "$_lua_source_one" >/dev/null 2>&1 || _lua_foreign_rc=$?
_assert_eq "Lua API link: a pre-existing directory rejects activation" \
  1 "$_lua_foreign_rc"
_assert_true "Lua API link: rejected directory remains untouched" \
  test -f "$_lua_link_root/owned-by-user"

_cli_source="$_fixture_dir/cli-source"
_cli_lua_link="$_fixture_dir/cli-lua-link"
_cli_target="$_fixture_dir/bin/shdeps"
mkdir -p "$_cli_source/lua/shdeps" "$(dirname "$_cli_target")"
printf 'return {}\n' >"$_cli_source/lua/shdeps.lua"
printf 'return {}\n' >"$_cli_source/lua/shdeps/bootstrap.lua"
printf '#!/usr/bin/env bash\nexit 0\n' >"$_cli_source/shdeps"
chmod +x "$_cli_source/shdeps"
printf 'owned elsewhere\n' >"$_cli_target"
_saved_lua_dir="$SHDEPS_LUA_DIR"
_saved_shdeps_bin="$SHDEPS_BIN"
SHDEPS_LUA_DIR="$_cli_lua_link"
SHDEPS_BIN="$_cli_target"
_cli_foreign_rc=0
_cli_foreign_output=$(_setup_links "$_cli_source" 2>&1) ||
  _cli_foreign_rc=$?
_assert_eq "CLI link: a pre-existing file rejects activation" \
  1 "$_cli_foreign_rc"
_assert_eq "CLI link: rejected file remains untouched" \
  "owned elsewhere" "$(cat "$_cli_target")"
_assert_false "CLI link: rejected activation publishes no Lua API" \
  test -L "$_cli_lua_link"
_assert_contains "CLI link: rejection is actionable" \
  "not a symlink; refusing to replace it" "$_cli_foreign_output"

_rollback_lua_link="$_fixture_dir/rollback-lua-link"
_rollback_cli_target="$_fixture_dir/rollback-bin/shdeps"
_rollback_prior_target=--help
mkdir -p "$(dirname "$_rollback_cli_target")"
ln -s -- "$_rollback_prior_target" "$_rollback_lua_link"
SHDEPS_LUA_DIR="$_rollback_lua_link"
SHDEPS_BIN="$_rollback_cli_target"
ln() {
  local ln_args=("$@")
  local ln_operand_count=${#ln_args[@]}
  local ln_source_operand=${ln_args[$((ln_operand_count - 2))]}
  local ln_target_operand=${ln_args[$((ln_operand_count - 1))]}
  command ln "$@" || return $?
  if [[ "$ln_source_operand" == "$_cli_source/shdeps" &&
    "$ln_target_operand" == "$_rollback_cli_target" ]]; then
    printf 'injected late ln failure\n' >&2
    return 73
  fi
}
_rollback_rc=0
_rollback_output=$(_setup_links "$_cli_source" 2>&1) || _rollback_rc=$?
unset -f ln
_assert_eq "link transaction: late CLI failure preserves its status" \
  73 "$_rollback_rc"
_assert_contains "link transaction: late CLI failure preserves its diagnostic" \
  "injected late ln failure" "$_rollback_output"
_assert_eq "link transaction: restores an option-like Lua API target" \
  "$_rollback_prior_target" "$(readlink "$_rollback_lua_link")"
_assert_false "link transaction: removes the newly published CLI link" \
  test -L "$_rollback_cli_target"

SHDEPS_LUA_DIR="$_saved_lua_dir"
SHDEPS_BIN="$_saved_shdeps_bin"

echo "=== install.sh: combined propagation diagnostics ==="

_combined_diag_dir="$_fixture_dir/combined-diagnostic"
mkdir -p "$_combined_diag_dir"
_combined_diag=$(
