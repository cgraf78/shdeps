  _shdeps_tx_release_owned=0
  _install_transaction_remember_cleanup_failure
  printf '%s\n' "$_SHDEPS_INSTALL_PROPAGATION_MESSAGE"
)
_assert_contains "combined diagnostic: committed activation guidance survives cleanup failure" \
  "payload was committed, but activation was interrupted" "$_combined_diag"
_assert_contains "combined diagnostic: manual recovery guidance is appended" \
  "transaction cleanup requires manual recovery" "$_combined_diag"

