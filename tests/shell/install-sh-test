#!/usr/bin/env bash
# shellcheck disable=SC1091
# install-sh-test — focused tests for install.sh helper functions.
#
# install.sh is the curl-pipe bootstrap script; its helpers cannot be
# covered by the Rust test suite. This file sources install.sh in a
# controlled subshell (which is safe because the dispatch is guarded by a
# sourced-vs-executed check at the bottom of the script) and exercises the
# helpers directly. Test cases stay small and focused; behavioral coverage
# of the full install/bootstrap path lives in `scripts/smoke-install-bash32.sh`
# and the Rust integration suite.

set -euo pipefail

# Resolve the repo root from the test script's own location so the test
# can be invoked from any working directory. Inlined rather than wrapped
# in a helper because shellcheck (SC2218) sometimes false-positives on
# command-substitution call sites for top-level helpers.
_test_dir=$(
  src="${BASH_SOURCE[0]}"
  case "$src" in
    */*) dir="${src%/*}" ;;
    *) dir="." ;;
  esac
  cd -P -- "$dir" && pwd
)
_repo_root=$(cd -P -- "$_test_dir/../.." && pwd)

_pass_count=0
_fail_count=0

_pass() {
  printf '  PASS: %s\n' "$*"
  _pass_count=$((_pass_count + 1))
}

_fail() {
  printf '  FAIL: %s\n' "$*"
  _fail_count=$((_fail_count + 1))
}

_assert_true() {
  local label="$1"
  shift
  if "$@"; then
    _pass "$label"
  else
    _fail "$label (expected success; exit $?)"
  fi
}

_assert_false() {
  local label="$1"
  shift
  if "$@"; then
    _fail "$label (expected failure but command succeeded)"
  else
    _pass "$label"
  fi
}

_assert_eq() {
  local label="$1" expected="$2" actual="$3"
  if [[ "$expected" == "$actual" ]]; then
    _pass "$label"
  else
    _fail "$label (expected: $expected, actual: $actual)"
  fi
}

# Source install.sh in this shell with the dispatch suppressed via the
# documented opt-out env var. The opt-out is necessary because
# `. install.sh --bootstrap` is a real invocation pattern that the
# script supports; the BASH_SOURCE-vs-$0 trick would silently disable
# bootstrap as well. With the env var set, sourcing only loads helper
# definitions.
SHDEPS_INSTALL_SH_NO_DISPATCH=1
export SHDEPS_INSTALL_SH_NO_DISPATCH
# shellcheck source=../install.sh
source "$_repo_root/install.sh"
unset SHDEPS_INSTALL_SH_NO_DISPATCH

_fixture_dir=$(mktemp -d)
trap 'rm -rf "$_fixture_dir"' EXIT

echo "=== install.sh: _curl_config_quote ==="

# The bearer token + URL are passed through `_curl_config_quote`
# before being embedded in `"..."`-quoted curl config fields.
# Escape contract: `\` → `\\`, `"` → `\"`. Plain alphanumerics
# pass through unchanged. Tokens from `gh auth token` are
# alphanumeric, but escaping is defensive against a malformed
# `SHDEPS_GH_TOKEN`.
_assert_eq "quote: alphanumeric passthrough" \
  "ghp_abc123XYZ" "$(_curl_config_quote 'ghp_abc123XYZ')"
_assert_eq 'quote: backslash doubled' \
  'a\\b' "$(_curl_config_quote 'a\b')"
_assert_eq 'quote: double-quote escaped' \
  'a\"b' "$(_curl_config_quote 'a"b')"
_assert_eq 'quote: backslash before quote order-correct' \
  'a\\\"b' "$(_curl_config_quote 'a\"b')"

echo "=== install.sh: _github_token ==="

_gh_stub_dir=$(mktemp -d)
cat >"$_gh_stub_dir/gh" <<'EOF'
#!/usr/bin/env bash
printf 'gh should not run in headless tests\n' >>"$SHDEPS_GH_STUB_LOG"
printf 'stub-token\n'
EOF
chmod +x "$_gh_stub_dir/gh"
_old_path="$PATH"
PATH="$_gh_stub_dir:$PATH"
export PATH
SHDEPS_GH_STUB_LOG="$_gh_stub_dir/calls"
export SHDEPS_GH_STUB_LOG

_old_gh_token_set=0
_old_github_token_set=0
if [[ -n ${GH_TOKEN+x} ]]; then
  _old_gh_token_set=1
  _old_gh_token="$GH_TOKEN"
fi
if [[ -n ${GITHUB_TOKEN+x} ]]; then
  _old_github_token_set=1
  _old_github_token="$GITHUB_TOKEN"
fi

unset GH_TOKEN GITHUB_TOKEN
_assert_eq "github token: headless skips gh credential helper" "" "$(_github_token)"
_assert_false "github token: headless did not invoke gh" test -s "$SHDEPS_GH_STUB_LOG"

GH_TOKEN="explicit-gh-token"
export GH_TOKEN
unset GITHUB_TOKEN
_assert_eq "github token: GH_TOKEN wins" "explicit-gh-token" "$(_github_token)"

GITHUB_TOKEN="explicit-github-token"
export GITHUB_TOKEN
unset GH_TOKEN
_assert_eq "github token: GITHUB_TOKEN fallback" "explicit-github-token" "$(_github_token)"

if [[ $_old_gh_token_set -eq 1 ]]; then
  GH_TOKEN="$_old_gh_token"
  export GH_TOKEN
else
  unset GH_TOKEN
fi
if [[ $_old_github_token_set -eq 1 ]]; then
  GITHUB_TOKEN="$_old_github_token"
  export GITHUB_TOKEN
else
  unset GITHUB_TOKEN
fi

PATH="$_old_path"
export PATH
rm -rf "$_gh_stub_dir"

echo "=== install.sh: _archive_entries_safe ==="

_archive_dir=$(mktemp -d)
trap 'rm -rf "$_fixture_dir" "$_archive_dir"' EXIT

# Safe archive: relative paths only.
_safe_archive="$_archive_dir/safe.tar.gz"
(
  cd "$_archive_dir"
  mkdir -p stage/bin stage/share/man/man1
  printf '#!/bin/sh\n' >stage/bin/shdeps
  printf '.TH SHDEPS 1\n' >stage/share/man/man1/shdeps.1
  tar -czf safe.tar.gz -C stage .
)
_assert_true "archive guard accepts a clean relative-path archive" \
  _archive_entries_safe "$_safe_archive"

# Hostile archive: absolute path. Use tar's --absolute-names where
# available; otherwise build via a tar member with a leading slash.
_evil_abs="$_archive_dir/evil-abs.tar.gz"
(
  cd "$_archive_dir"
  mkdir -p stage_abs/tmp
  printf 'evil\n' >stage_abs/tmp/file
  # tar normally strips leading slashes; use the -P flag (GNU) or
  # --absolute-paths (BSD) to preserve them. Fall back to a manual
  # path manipulation that the consumer-side `case` test catches.
  if tar --help 2>&1 | grep -q -- '--absolute-names'; then
    tar -czPf evil-abs.tar.gz /tmp/shdeps-test-evil-marker 2>/dev/null ||
      tar -czf evil-abs.tar.gz --transform 's,^,/abs/,' -C stage_abs tmp/file 2>/dev/null ||
      cp "$_safe_archive" evil-abs.tar.gz
  else
    cp "$_safe_archive" evil-abs.tar.gz
  fi
)
# If we built a real absolute-path archive above, the guard must refuse.
# If the tar flavor refused to build one, the test is a no-op (the
# `cp $_safe_archive` fallback would let the guard accept it), so guard
# only-fail when we can confirm the archive actually has an abs path.
if tar -tzf "$_evil_abs" 2>/dev/null | grep -qE '^/'; then
  _assert_false "archive guard refuses absolute-path entries" \
    _archive_entries_safe "$_evil_abs"
fi

# Hostile archive: `..` traversal in a path component.
_evil_dotdot="$_archive_dir/evil-dotdot.tar.gz"
(
  cd "$_archive_dir"
  mkdir -p stage_dd
  printf 'evil\n' >stage_dd/file
  # `tar --transform` (GNU) rewrites the member name to include `..`.
  if tar --help 2>&1 | grep -q -- '--transform'; then
    tar -czf evil-dotdot.tar.gz --transform 's,file,../escape,' -C stage_dd file
  else
    cp "$_safe_archive" evil-dotdot.tar.gz
  fi
)
if tar -tzf "$_evil_dotdot" 2>/dev/null | grep -qE '(^|/)\.\.(/|$)'; then
  _assert_false 'archive guard refuses dot-dot traversal entries' \
    _archive_entries_safe "$_evil_dotdot"
fi

echo "=== install.sh: _archive_entries_safe link rejection ==="

# Symlink entries can redirect an extracted file outside the bundle even
# when the entry name looks benign, so the guard must reject them (parity
# with `archive::reject_links`).
_evil_symlink="$_archive_dir/evil-symlink.tar.gz"
(
  cd "$_archive_dir"
  mkdir -p stage_sym
  ln -s /etc/passwd stage_sym/link 2>/dev/null || ln -s target stage_sym/link
  tar -czf evil-symlink.tar.gz -C stage_sym .
)
if tar -tzvf "$_evil_symlink" 2>/dev/null | grep -q '^l'; then
  _assert_false "archive guard refuses symlink entries" \
    _archive_entries_safe "$_evil_symlink"
fi

echo "=== install.sh: _curl_get_release_asset host validation ==="

# The browser asset URL is parsed from release JSON on the
# SHDEPS_RELEASE_API_URL path, so a tampered payload must not be able to
# redirect the download to an arbitrary host. The guard returns before any
# curl invocation, so these assertions need no network or curl stub.
_assert_false "release asset guard refuses non-GitHub host" \
  _curl_get_release_asset "https://evil.example/payload.tar.gz" "$_fixture_dir/host-out" "" ""
_assert_false "release asset guard refuses non-https github URL" \
  _curl_get_release_asset "http://github.com/x.tar.gz" "$_fixture_dir/host-out" "" ""

echo "=== install.sh: _verify_checksum binds to the archive ==="

_digest() {
  if command -v sha256sum >/dev/null 2>&1; then
    (cd "$1" && sha256sum "$2") | awk '{ print $1 }'
  else
    (cd "$1" && shasum -a 256 "$2") | awk '{ print $1 }'
  fi
}

_ck_dir=$(mktemp -d)
printf 'payload\n' >"$_ck_dir/app.tar.gz"
_ck_real=$(_digest "$_ck_dir" app.tar.gz)
printf '%s  app.tar.gz\n' "$_ck_real" >"$_ck_dir/app.tar.gz.sha256"
_assert_true "verify_checksum accepts the matching named line" \
  _verify_checksum "$_ck_dir" app.tar.gz app.tar.gz.sha256

# Binary-mode `*` prefix and `./` prefix must also be accepted.
printf '%s *./app.tar.gz\n' "$_ck_real" >"$_ck_dir/app-binmode.sha256"
_assert_true "verify_checksum accepts binary-mode and ./ prefixed names" \
  _verify_checksum "$_ck_dir" app.tar.gz app-binmode.sha256

# Wrong digest for the archive must fail.
printf '%s  app.tar.gz\n' "$(printf '0%.0s' $(seq 1 64))" >"$_ck_dir/wrong.sha256"
_assert_false "verify_checksum rejects a wrong digest" \
  _verify_checksum "$_ck_dir" app.tar.gz wrong.sha256

# The core fix: a checksum file that only names a DIFFERENT (present,
# matching) file must NOT verify the archive. Plain `sha256sum -c` would
# pass here because `other.tar.gz` checks out; binding to the archive name
# makes it fail closed.
printf 'payload\n' >"$_ck_dir/other.tar.gz"
_ck_other=$(_digest "$_ck_dir" other.tar.gz)
printf '%s  other.tar.gz\n' "$_ck_other" >"$_ck_dir/other-only.sha256"
_assert_false "verify_checksum rejects a checksum file lacking the archive entry" \
  _verify_checksum "$_ck_dir" app.tar.gz other-only.sha256

# A bare-hash line (no filename) must not vacuously verify any archive.
printf '%s\n' "$_ck_real" >"$_ck_dir/bare.sha256"
_assert_false "verify_checksum rejects a bare-hash line" \
  _verify_checksum "$_ck_dir" app.tar.gz bare.sha256

rm -rf "$_ck_dir"

echo "=== install.sh: _curl_get keeps the bearer token off argv ==="

# The token must travel via `curl --config -` over stdin, never argv, so it
# is not visible to `ps` / `/proc/<pid>/cmdline`.
_curl_stub_dir=$(mktemp -d)
cat >"$_curl_stub_dir/curl" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$SHDEPS_TEST_CURL_ARGV"
_has_config=0
_out=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config) _has_config=1; shift 2 ;;
    -o) _out="$2"; shift 2 ;;
    *) shift ;;
  esac
done
if [[ "$_has_config" == 1 ]]; then
  cat >>"$SHDEPS_TEST_CURL_STDIN"
fi
[[ -n "$_out" ]] && : >"$_out"
exit 0
EOF
chmod +x "$_curl_stub_dir/curl"

SHDEPS_TEST_CURL_ARGV="$_curl_stub_dir/argv"
SHDEPS_TEST_CURL_STDIN="$_curl_stub_dir/stdin"
export SHDEPS_TEST_CURL_ARGV SHDEPS_TEST_CURL_STDIN
: >"$SHDEPS_TEST_CURL_ARGV"
: >"$SHDEPS_TEST_CURL_STDIN"

_old_path_curl="$PATH"
PATH="$_curl_stub_dir:$PATH"
export PATH
_curl_get "https://api.github.com/repos/o/r/releases/latest" "$_curl_stub_dir/out" "secret-token-xyz"
PATH="$_old_path_curl"
export PATH

_assert_false "curl_get: token absent from argv" \
  grep -q "secret-token-xyz" "$SHDEPS_TEST_CURL_ARGV"
_assert_true "curl_get: --config used on stdin" \
  grep -q -- "--config" "$SHDEPS_TEST_CURL_ARGV"
_assert_true "curl_get: token delivered via stdin config" \
  grep -q "secret-token-xyz" "$SHDEPS_TEST_CURL_STDIN"

unset SHDEPS_TEST_CURL_ARGV SHDEPS_TEST_CURL_STDIN
rm -rf "$_curl_stub_dir"

echo "=== shdeps.sh: PATH fallback opt-in ==="

# The wrapper used to silently fall through to whatever `shdeps` happened
# to be on `$PATH`. In shared/CI environments that produced cryptic
# wrong-binary failures. The fallback is now opt-in via
# `SHDEPS_ALLOW_PATH_FALLBACK=1`. Verify both halves:
#   1) Without the env var, sourcing fails to find a binary when no
#      sibling/cargo build exists.
#   2) With the env var, the PATH binary is found.

_path_dir=$(mktemp -d)
cat >"$_path_dir/shdeps" <<EOF
#!/usr/bin/env bash
case "\$1 \$2" in
  '__api version') echo "abi:1" ;;
  '__api env-snapshot') echo "platform=linux" ;;
  *) echo "" ;;
esac
EOF
chmod +x "$_path_dir/shdeps"

# Stage a directory containing ONLY shdeps.sh (no sibling binary, no
# Cargo target tree) so the resolver falls through to the PATH branch.
_isolation_dir=$(mktemp -d)
cp "$_repo_root/shdeps.sh" "$_isolation_dir/shdeps.sh"

# Invoke the *current* bash interpreter via `$BASH` rather than a bare
# `bash`. On macOS the system `/bin/bash` is 3.2, and the restricted PATH
# below (`/usr/bin:/bin`) leaves the bash-3.2 binary as the only `bash`
# the subshell could find. `shdeps.sh` requires 4.3+ and would abort at
# its version-guard before ever reaching the PATH-fallback branch, so the
# test would assert against an unrelated failure mode. `$BASH` always
# points at the interpreter running this script, which the outer
# `#!/usr/bin/env bash` resolves to a 4.3+ binary on every CI runner.
_path_default=$(
  # Use newline-separated commands so the echo runs regardless of
  # source's exit code. The earlier audit flagged a hypothetical
  # `&&` form that would silently skip the echo; this form is robust
  # against that. Also capture the source exit code separately so we
  # can assert source actually FAILED (a vacuous pass would be the
  # source succeeding with an empty `_SHDEPSW_BIN`).
  PATH="$_path_dir:/usr/bin:/bin" "$BASH" -c "
    source '$_isolation_dir/shdeps.sh' 2>/dev/null
    _src_rc=\$?
    echo \"BIN=\${_SHDEPSW_BIN:-NONE} SRC_RC=\$_src_rc\"
  " 2>/dev/null
)
_assert_eq "PATH fallback off by default: source fails AND BIN unset" \
  "BIN=NONE SRC_RC=1" "$_path_default"

_path_opted_in=$(
  PATH="$_path_dir:/usr/bin:/bin" SHDEPS_ALLOW_PATH_FALLBACK=1 \
    "$BASH" -c "
      source '$_isolation_dir/shdeps.sh'
      echo \"BIN=\$_SHDEPSW_BIN\"
    " 2>/dev/null
)
_assert_eq "PATH fallback honored with SHDEPS_ALLOW_PATH_FALLBACK=1" \
  "BIN=$_path_dir/shdeps" "$_path_opted_in"

rm -rf "$_path_dir" "$_isolation_dir"

echo ""
echo "================================"
echo "Results: $_pass_count passed, $_fail_count failed"
echo "================================"

if [[ $_fail_count -gt 0 ]]; then
  exit 1
fi
