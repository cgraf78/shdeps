#!/usr/bin/env bash
# shellcheck disable=SC1091
# shdeps-specific release coverage.
#
# The release scripts themselves are vendored from cgraf78/actions and covered
# by that repo's test/release-scripts-test: identity resolution, packaging,
# smoke validation, and local tag cutting all live there. Re-asserting them here
# would recreate the triplicated coverage this consolidation removed.
#
# What stays is what only this repo can know: that release.conf declares the
# payload shdeps actually ships, that the smoke hook works, and that the
# workflows wire the shared release contract the way this project needs.

set -uo pipefail

SHDEPS_DIR="$(cd "$(dirname "$0")/../.." && pwd)"

# shellcheck source=helpers.sh
. "$(dirname "$0")/helpers.sh"

echo "=== Release scripts ==="

# shellcheck source=../../scripts/release.conf
. "$SHDEPS_DIR/scripts/release.conf"

_assert_eq "release config: uses the shdeps env namespace" \
  "SHDEPS" "$RELEASE_ENV_PREFIX"
_assert_eq "release config: names the shdeps binary" "shdeps" "$RELEASE_BINARY"
_assert_eq "release config: publishes shdeps-prefixed archives" \
  "shdeps" "$RELEASE_ASSET_NAME"

_declared() {
  local needle=$1 entry
  for entry in "${RELEASE_PAYLOAD_FILES[@]}"; do
    [[ "$entry" == "$needle" ]] && return 0
  done
  return 1
}

# A declared entry that no longer exists fails the release on a runner rather
# than here, which is a slow way to discover a rename.
for _entry in "${RELEASE_PAYLOAD_FILES[@]}"; do
  if [[ -f "$SHDEPS_DIR/$_entry" ]]; then
    _pass "release config: declared payload exists: $_entry"
  else
    _fail "release config: declared payload exists: $_entry"
  fi
done

# The reverse direction is the one that actually bites: adding a completion or
# Lua module and forgetting to ship it. Markdown in these trees is contributor
# documentation rather than runtime payload, so it is excluded deliberately.
while IFS= read -r _tracked; do
  if _declared "$_tracked"; then
    _pass "release config: ships tracked file: $_tracked"
  else
    _fail "release config: ships tracked file: $_tracked"
  fi
done < <(git -C "$SHDEPS_DIR" ls-files -- completions lua man/man1/shdeps.1 ':!:*.md')

# The sourceable wrapper is the public Bash API and install.sh is how an
# extracted archive activates itself. Losing either silently breaks bootstrap.
for _required in shdeps.sh install.sh; do
  if _declared "$_required"; then
    _pass "release config: ships $_required"
  else
    _fail "release config: ships $_required"
  fi
done

# --- Smoke hook -------------------------------------------------------------

# shellcheck source=../../scripts/release-smoke-hook.sh
. "$SHDEPS_DIR/scripts/release-smoke-hook.sh"

if declare -F release_smoke_check >/dev/null; then
  _pass "smoke hook: defines release_smoke_check"
else
  _fail "smoke hook: defines release_smoke_check"
fi

# The probe deliberately checks absolute Homebrew paths, so it cannot be
# neutralized portably from a test: PATH= does not hide /usr/local/bin/bash on a
# macOS runner. Assert the hook's observable behavior instead and let the real
# release smoke exercise the probe on the platform where it matters.
_hook_fake=$(mktemp -d)
printf '#!/usr/bin/env bash\nexit 0\n' >"$_hook_fake/shdeps"
chmod +x "$_hook_fake/shdeps"
printf 'shdeps_version() { printf "stub\\n"; }\n' >"$_hook_fake/shdeps.sh"

rc=0
release_smoke_check "$_hook_fake" linux-x86_64-musl >/dev/null 2>&1 || rc=$?
_assert_exit "smoke hook: accepts a working binary and sourceable wrapper" 0 "$rc"

# A binary that fails must fail the smoke test rather than being swallowed.
printf '#!/usr/bin/env bash\nexit 3\n' >"$_hook_fake/shdeps"
rc=0
release_smoke_check "$_hook_fake" linux-x86_64-musl >/dev/null 2>&1 || rc=$?
if [[ "$rc" -ne 0 ]]; then
  _pass "smoke hook: propagates a failing binary"
else
  _fail "smoke hook: propagates a failing binary"
fi

# A wrapper that does not define shdeps_version means the packaged Bash API is
# broken even though the binary works.
printf '#!/usr/bin/env bash\nexit 0\n' >"$_hook_fake/shdeps"
printf '# no shdeps_version here\n' >"$_hook_fake/shdeps.sh"
rc=0
release_smoke_check "$_hook_fake" linux-x86_64-musl >/dev/null 2>&1 || rc=$?
if [[ "$rc" -ne 0 ]]; then
  _pass "smoke hook: catches a wrapper missing its public API"
else
  _fail "smoke hook: catches a wrapper missing its public API"
fi
rm -rf "$_hook_fake"

# --- Workflow contract ------------------------------------------------------

_release_workflow=$(cat "$SHDEPS_DIR/.github/workflows/release.yml")
_assert_contains "release workflow: uses exact reusable tag command" \
  'tag-command: scripts/release-tag.sh' "$_release_workflow"
_assert_contains "release workflow: enables Android x86_64 artifact" \
  "android-x86_64: true" "$_release_workflow"

_test_workflow=$(cat "$SHDEPS_DIR/.github/workflows/test.yml")
_termux_host_command=$(
  sed -n '/^[[:space:]]*termux-host-command:/,/^[[:space:]]*android-package-smoke-command:/p' \
    <<<"$_test_workflow"
)
_assert_contains "test workflow: packages the Android x86_64 release archive" \
  "scripts/package-release.sh \"\$RUST_TARGET\" \"\$ASSET_PLATFORM\"" \
  "$_termux_host_command"
_assert_contains "test workflow: keeps Cargo artifacts out of transported checkout" \
  "CARGO_TARGET_DIR=\"\$RUNNER_TEMP/shdeps-termux-target\"" \
  "$_termux_host_command"
_assert_contains "test workflow: smokes the Android x86_64 release archive" \
  "scripts/smoke-release.sh \"\$ASSET_PLATFORM\"" "$_termux_host_command"

# Vendored copies are only equivalent to a single source while CI enforces it.
_assert_contains "test workflow: verifies the vendored release scripts" \
  "verify-release-scripts" "$_test_workflow"

_test_summary
