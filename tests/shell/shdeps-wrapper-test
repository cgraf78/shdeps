#!/usr/bin/env bash
# shellcheck disable=SC1091
# Focused smoke tests for the Rust-era sourceable compatibility wrapper.
#
# This file targets the public sourceable surface: source `shdeps.sh`, call
# public `shdeps_*` functions, and verify the wrapper delegates to the Rust
# binary without requiring callers to change.

set -uo pipefail

SHDEPS_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
SHDEPS_RUST_CLI="${SHDEPS_RUST_CLI:-$SHDEPS_DIR/target/debug/shdeps}"
# The Rust binary owns version formatting, and the wrapper must pass that exact
# line through. The timestamp keeps release identities readable, while the
# mandatory hash suffix preserves the old source-only "always commit-based"
# guarantee without reintroducing a hand-maintained VERSION file.
_version_line_re='^shdeps [0-9]{8}-[0-9]{6}-[0-9a-fA-F]{8}$'

# shellcheck source=helpers.sh
. "$(dirname "$0")/helpers.sh"

echo "=== Rust wrapper ==="

if [[ ! -x "$SHDEPS_RUST_CLI" ]]; then
  printf 'error: %s is not executable; run cargo build or set SHDEPS_RUST_CLI\n' "$SHDEPS_RUST_CLI" >&2
  exit 2
fi

_wrapper_lint=$(
  awk '
    /^shdeps_[A-Za-z0-9_]+\(\)[[:space:]]*\{/ {
      name = $1
      sub(/\(\).*/, "", name)
      if ($0 ~ /\{.*\}/) {
        next
      }
      if (name == "shdeps_dep_source" || name == "shdeps_mark_changed") {
        next
      }
      print name " is not a one-line public shim"
    }
  ' "$SHDEPS_DIR/shdeps.sh"
)
if [[ -z "$_wrapper_lint" ]]; then
  _pass "wrapper lint: public shims stay one-line"
else
  _fail "wrapper lint: public shims stay one-line"
  while IFS= read -r _line; do
    printf '    %s\n' "$_line" >&2
  done <<<"$_wrapper_lint"
fi

_mock_home

_conf=$(_tmpdir)
_state=$(_tmpdir)
_install=$(_tmpdir)
_bin=$(_tmpdir)
_git_dev=$(_tmpdir)

cat >"$_conf/deps.conf" <<'EOF'
owner/tool github:repo
cgraf78/agentguard github
cgraf78/cmdblocks github
EOF
mkdir -p "$_install/owner/tool/share"
cat >"$_install/owner/tool/share/env.sh" <<'EOF'
SHDEPS_WRAPPER_SOURCED=1
EOF
mkdir -p "$_install/owner/tool/bin"
cat >"$_install/owner/tool/bin/tool" <<'EOF'
#!/bin/sh
EOF
chmod +x "$_install/owner/tool/bin/tool"
mkdir -p "$_git_dev/agentguard/lib/agentguard" "$_git_dev/cmdblocks/share/cmdblocks"
printf '# agentguard\n' >"$_git_dev/agentguard/lib/agentguard/agentguard.sh"
printf '%s\n' "CMDBLOCKS_SHELL_LOADED=1" >"$_git_dev/cmdblocks/share/cmdblocks/shell.sh"

export SHDEPS_RUST_CLI
export SHDEPS_CONF_DIR="$_conf"
export SHDEPS_STATE_DIR="$_state"
export SHDEPS_INSTALL_DIR="$_install"
export SHDEPS_BIN_DIR="$_bin"
export SHDEPS_GIT_DEV_DIR="$_git_dev"
export SHDEPS_LOG_LEVEL=0

# shellcheck source=../shdeps.sh
. "$SHDEPS_DIR/shdeps.sh" || {
  _fail "wrapper: source succeeds"
  _test_summary
}
_pass "wrapper: source succeeds"

if declare -f shdeps_update >/dev/null; then
  _pass "wrapper: defines shdeps_update"
else
  _fail "wrapper: defines shdeps_update"
fi

if declare -f shdeps_dep_source >/dev/null; then
  _pass "wrapper: defines shdeps_dep_source"
else
  _fail "wrapper: defines shdeps_dep_source"
fi

_version=$(shdeps_version)
_assert_match "wrapper: version delegates to Rust binary" "$_version_line_re" "$_version"

_assert_eq "wrapper: shdeps_log prints at normal log level" \
  "test message" "$(SHDEPS_LOG_LEVEL=1 shdeps_log "test message")"
_assert_eq "wrapper: shdeps_log suppresses at quiet log level" \
  "" "$(SHDEPS_LOG_LEVEL=0 shdeps_log "test message")"
_warn_output=$(SHDEPS_LOG_LEVEL=1 shdeps_warn "test warning" 2>&1)
_assert_eq "wrapper: shdeps_warn writes stderr" "test warning" "$_warn_output"
_assert_eq "wrapper: shdeps_log_ok delegates to shdeps_log" \
  "test ok" "$(SHDEPS_LOG_LEVEL=1 shdeps_log_ok "test ok")"
_assert_eq "wrapper: shdeps_log_dim delegates to shdeps_log" \
  "test dim" "$(SHDEPS_LOG_LEVEL=1 shdeps_log_dim "test dim")"

_assert_eq "wrapper: install dir cached from Rust env" "$_install" "$(shdeps_install_dir)"
_assert_eq "wrapper: bin dir cached from Rust env" "$_bin" "$(shdeps_bin_dir)"
_assert_eq "wrapper: git dev dir cached from Rust env" "$_git_dev" "$(shdeps_git_dev_dir)"
_assert_match "wrapper: platform available" '^(linux|macos|wsl)$' "$(shdeps_platform)"

_assert_eq "wrapper: pkg mgr starts as cached empty read" "" "$(shdeps_pkg_mgr)"
export SHDEPS_PKG_MGR=apt
_assert_eq "wrapper: pkg mgr honors explicit shell cache" "apt" "$(shdeps_pkg_mgr)"
unset SHDEPS_PKG_MGR

export SHDEPS_FORCE=1
if shdeps_force; then
  _pass "wrapper: force predicate returns shell success"
else
  _fail "wrapper: force predicate returns shell success"
fi
export SHDEPS_FORCE=0
if shdeps_force; then
  _fail "wrapper: force predicate returns shell failure"
else
  _pass "wrapper: force predicate returns shell failure"
fi

unset SHDEPS_WRAPPER_SOURCED
shdeps_dep_source owner/tool share/env.sh
_assert_eq "wrapper: dep-source sources into current shell" "1" "${SHDEPS_WRAPPER_SOURCED:-}"

_assert_eq "wrapper: bare github dep-file prefers local dev clone" \
  "$_git_dev/agentguard/lib/agentguard/agentguard.sh" \
  "$(shdeps_dep_file cgraf78/agentguard lib/agentguard/agentguard.sh)"

_assert_eq "wrapper: dep-links delegates to Rust binary" \
  "tool	$_bin/tool	$_install/owner/tool/bin/tool" \
  "$(shdeps_dep_links owner/tool)"

unset CMDBLOCKS_SHELL_LOADED
shdeps_dep_source cgraf78/cmdblocks share/cmdblocks/shell.sh
_assert_eq "wrapper: bare github dep-source uses local dev clone" \
  "1" "${CMDBLOCKS_SHELL_LOADED:-}"

SHDEPS_UPDATE_TXN_ID=txn123 shdeps_mark_changed owner/tool
_assert_file_exists "wrapper: mark-changed writes txn sentinel" "$_state/.changed-markers/txn123/owner/tool"

_cache_fake=$(_tmpdir)/shdeps
cat >"$_cache_fake" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${SHDEPS_WRAPPER_CACHE_LOG:?missing cache log}"
case "${1:-}:${2:-}" in
  __api:version)
    printf '%s\n' "abi:1"
    ;;
  __api:env-snapshot)
    printf '%s\n' \
      "install_dir=/cache/install" \
      "bin_dir=/cache/bin" \
      "git_dev_dir=/cache/git" \
      "platform=linux" \
      "pkg_mgr=" \
      "force=0" \
      "reinstall=0"
    ;;
  *)
    printf 'unexpected wrapper cache call: %s\n' "$*" >&2
    exit 9
    ;;
esac
SH
chmod +x "$_cache_fake"
_cache_log=$(_tmpdir)/wrapper-cache.log
_cache_output=$(
  SHDEPS_RUST_CLI="$_cache_fake" \
    SHDEPS_WRAPPER_CACHE_LOG="$_cache_log" \
    bash -c '
      unset SHDEPS_INSTALL_DIR SHDEPS_BIN_DIR SHDEPS_GIT_DEV_DIR
      . "$1"
      shdeps_install_dir
      shdeps_bin_dir
      shdeps_git_dev_dir
      shdeps_platform
      shdeps_install_dir >/dev/null
      shdeps_pkg_mgr >/dev/null
    ' \
    bash "$SHDEPS_DIR/shdeps.sh"
)
_assert_eq "wrapper cache: cached helper output" $'/cache/install\n/cache/bin\n/cache/git\nlinux' "$_cache_output"
_cache_log_content=$(cat "$_cache_log")
_cache_env_count=$(grep -c '^__api env-snapshot$' "$_cache_log" || true)
_assert_eq "wrapper cache: env snapshot called once" "1" "$_cache_env_count"
_assert_not_contains "wrapper cache: install-dir not refetched" "__api install-dir" "$_cache_log_content"
_assert_not_contains "wrapper cache: bin-dir not refetched" "__api bin-dir" "$_cache_log_content"
_assert_not_contains "wrapper cache: git-dev-dir not refetched" "__api git-dev-dir" "$_cache_log_content"
_assert_not_contains "wrapper cache: platform not refetched" "__api platform" "$_cache_log_content"

_path_fake=$(_tmpdir)/shdeps
cat >"$_path_fake" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
case "${1:-}:${2:-}" in
  __api:version)
    printf '%s\n' "abi:1"
    ;;
  __api:env-snapshot)
    printf '%s\n' \
      "install_dir=/path/install" \
      "bin_dir=/path/bin" \
      "git_dev_dir=/path/git" \
      "platform=linux" \
      "pkg_mgr=" \
      "force=0" \
      "reinstall=0"
    ;;
  update:)
    printf 'update path=%s dir=%s\n' "$PATH" "${SHDEPS_DIR:-}" >>"${SHDEPS_WRAPPER_PATH_LOG:?missing path log}"
    ;;
  self-update:)
    printf 'self-update dir=%s\n' "${SHDEPS_DIR:-}" >>"${SHDEPS_WRAPPER_PATH_LOG:?missing path log}"
    ;;
  *)
    printf 'unexpected wrapper path call: %s\n' "$*" >&2
    exit 9
    ;;
esac
SH
chmod +x "$_path_fake"
_path_log=$(_tmpdir)/wrapper-path.log
_path_output=$(
  SHDEPS_RUST_CLI="$_path_fake" \
    SHDEPS_WRAPPER_PATH_LOG="$_path_log" \
    PATH="/usr/bin:/bin" \
    "$(command -v bash)" -c "
      unset SHDEPS_BIN_DIR
      . \"\$1\"
      shdeps_update
      shdeps_self_update
      printf '%s\n' \"\$PATH\"
    " \
    bash "$SHDEPS_DIR/shdeps.sh"
)
_assert_eq "wrapper update: prepends cached bin dir in caller" "/path/bin:/usr/bin:/bin" "$_path_output"
_assert_contains "wrapper update: child sees prepended bin dir" \
  "update path=/path/bin:/usr/bin:/bin" "$(cat "$_path_log")"
_assert_contains "wrapper update: child sees source dir" \
  "dir=$SHDEPS_DIR" "$(cat "$_path_log")"
_assert_contains "wrapper self-update: child sees source dir" \
  "self-update dir=$SHDEPS_DIR" "$(cat "$_path_log")"

_fake=$(_tmpdir)/shdeps
cat >"$_fake" <<'SH'
#!/usr/bin/env bash
if [[ "${1:-}" == "__api" && "${2:-}" == "version" ]]; then
  printf 'abi:999\n'
  exit 0
fi
exit 1
SH
chmod +x "$_fake"

_abi_output=$(SHDEPS_RUST_CLI="$_fake" bash -c '. "$1"' bash "$SHDEPS_DIR/shdeps.sh" 2>&1)
_abi_rc=$?
_assert_exit "wrapper: ABI mismatch refuses source" 1 "$_abi_rc"
_assert_contains "wrapper: ABI mismatch explains refusal" "unsupported wrapper ABI" "$_abi_output"

_bash=$(command -v bash)
_missing_dir=$(_tmpdir)
cp "$SHDEPS_DIR/shdeps.sh" "$_missing_dir/shdeps.sh"
_missing_output=$(PATH=/nonexistent SHDEPS_RUST_CLI='' "$_bash" -c ". \"\$1\"" bash "$_missing_dir/shdeps.sh" 2>&1)
_missing_rc=$?
_assert_exit "wrapper: missing binary refuses source" 1 "$_missing_rc"
_assert_contains "wrapper: missing binary explains refusal" "could not find the Rust shdeps binary" "$_missing_output"

_old_bash=""
for _candidate in "${SHDEPS_BASH32:-}" /bin/bash bash3.2 bash32; do
  [[ -n "$_candidate" ]] || continue
  if command -v "$_candidate" >/dev/null 2>&1; then
    _candidate_path=$(command -v "$_candidate")
    # shellcheck disable=SC2016  # evaluated by the candidate shell, not here
    _candidate_major=$("$_candidate_path" -c 'printf "%s\n" "${BASH_VERSINFO[0]}"' 2>/dev/null || printf '99')
    # shellcheck disable=SC2016  # evaluated by the candidate shell, not here
    _candidate_minor=$("$_candidate_path" -c 'printf "%s\n" "${BASH_VERSINFO[1]}"' 2>/dev/null || printf '99')
    if ((_candidate_major < 4 || (_candidate_major == 4 && _candidate_minor < 3))); then
      _old_bash="$_candidate_path"
      break
    fi
  fi
done
if [[ -n "$_old_bash" ]]; then
  # shellcheck disable=SC2016  # `$1` is intentionally expanded by old Bash
  _old_bash_output=$(SHDEPS_RUST_CLI="$_fake" "$_old_bash" -c '. "$1"' bash "$SHDEPS_DIR/shdeps.sh" 2>&1)
  _old_bash_rc=$?
  _assert_exit "wrapper: old Bash refuses source" 1 "$_old_bash_rc"
  _assert_contains "wrapper: old Bash explains version floor" "requires Bash 4.3 or newer" "$_old_bash_output"
else
  # CI usually runs the wrapper suite under a modern Linux Bash. Keep this as
  # an explicit skip/pass so macOS or local Bash-3.2 fixtures automatically
  # exercise the real source-time refusal without making Linux CI depend on an
  # extra old-shell package.
  _pass "wrapper: old Bash refusal skipped (no Bash <4.3 found)"
fi

_bootstrap_release=$(_tmpdir)
_bootstrap_state=$(_tmpdir)
_bootstrap_share=$(_tmpdir)
_bootstrap_bin_dir=$(_tmpdir)
_bootstrap_dev=$(_tmpdir)
cp "$SHDEPS_RUST_CLI" "$_bootstrap_release/shdeps"
cp "$SHDEPS_DIR/shdeps.sh" "$_bootstrap_release/shdeps.sh"
mkdir -p "$_bootstrap_release/man/man1" "$_bootstrap_release/completions"
printf '.TH SHDEPS 1\n' >"$_bootstrap_release/man/man1/shdeps.1"
printf '# completion\n' >"$_bootstrap_release/completions/shdeps.bash"
cat >"$_bootstrap_release/.shdeps-install.json" <<'JSON'
{"schema":1,"method":"release","artifact_platform":"linux-x86_64-musl","version":"20990203-040506-abc12345","tag":"20990203-040506-abc12345","repo":"cgraf78/shdeps"}
JSON

_bootstrap_bin="$_bootstrap_bin_dir/shdeps"
_install_sh="$SHDEPS_DIR/install.sh"
_bootstrap_output=$(
  env SHDEPS_DIR="$_bootstrap_release" \
    SHDEPS_BIN="$_bootstrap_bin" \
    SHDEPS_RUST_CLI='' \
    SHDEPS_STATE_DIR="$_bootstrap_state" \
    SHDEPS_INSTALL_DIR="$_bootstrap_share" \
    SHDEPS_GIT_DEV_DIR="$_bootstrap_dev" \
    "$_bash" -c ". \"\$1\" --bootstrap || exit 10; declare -f shdeps_update >/dev/null || exit 11; shdeps_version" \
    bash "$_install_sh"
)
_bootstrap_rc=$?
_assert_exit "bootstrap release wrapper: succeeds" 0 "$_bootstrap_rc"
_assert_match "bootstrap release wrapper: sourced Rust API" "$_version_line_re" "$_bootstrap_output"
_assert_symlink "bootstrap release wrapper: CLI linked" "$_bootstrap_bin"
_assert_eq "bootstrap release wrapper: CLI points at sibling binary" "$_bootstrap_release/shdeps" "$(readlink "$_bootstrap_bin")"
_assert_symlink "bootstrap release wrapper: man page linked through public helper" "$_bootstrap_share/man/man1/shdeps.1"

_test_summary
