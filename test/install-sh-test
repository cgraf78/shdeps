#!/usr/bin/env bash
# shellcheck disable=SC1091
# install-sh-test — focused tests for install.sh helper functions.
#
# install.sh is the curl-pipe bootstrap script; its helpers cannot be
# covered by the Rust test suite. This file sources install.sh in a
# controlled subshell (which is safe because the dispatch is guarded by a
# sourced-vs-executed check at the bottom of the script) and exercises the
# helpers directly. Test cases stay small and focused; behavioral coverage
# of the full install/bootstrap path lives in `scripts/smoke-install-bash32.sh`
# and the Rust integration suite.

set -euo pipefail

# Resolve the repo root from the test script's own location so the test
# can be invoked from any working directory. Inlined rather than wrapped
# in a helper because shellcheck (SC2218) sometimes false-positives on
# command-substitution call sites for top-level helpers.
_test_dir=$(
  src="${BASH_SOURCE[0]}"
  case "$src" in
    */*) dir="${src%/*}" ;;
    *) dir="." ;;
  esac
  cd -P -- "$dir" && pwd
)
_repo_root=$(cd -P -- "$_test_dir/.." && pwd)

_pass_count=0
_fail_count=0

_pass() {
  printf '  PASS: %s\n' "$*"
  _pass_count=$((_pass_count + 1))
}

_fail() {
  printf '  FAIL: %s\n' "$*"
  _fail_count=$((_fail_count + 1))
}

_assert_true() {
  local label="$1"
  shift
  if "$@"; then
    _pass "$label"
  else
    _fail "$label (expected success; exit $?)"
  fi
}

_assert_false() {
  local label="$1"
  shift
  if "$@"; then
    _fail "$label (expected failure but command succeeded)"
  else
    _pass "$label"
  fi
}

_assert_eq() {
  local label="$1" expected="$2" actual="$3"
  if [[ "$expected" == "$actual" ]]; then
    _pass "$label"
  else
    _fail "$label (expected: $expected, actual: $actual)"
  fi
}

# Source install.sh in this shell with the dispatch suppressed via the
# documented opt-out env var. The opt-out is necessary because
# `. install.sh --bootstrap` is a real invocation pattern that the
# script supports; the BASH_SOURCE-vs-$0 trick would silently disable
# bootstrap as well. With the env var set, sourcing only loads helper
# definitions.
SHDEPS_INSTALL_SH_NO_DISPATCH=1
export SHDEPS_INSTALL_SH_NO_DISPATCH
# shellcheck source=../install.sh
source "$_repo_root/install.sh"
unset SHDEPS_INSTALL_SH_NO_DISPATCH

echo "=== install.sh: _natural_tag_cmp ==="

# Date-prefixed YYYYMMDD-HHMMSS-hash tags: lexical and natural agree.
_assert_eq "natural: same tag is eq" "eq" \
  "$(_natural_tag_cmp '20260101-000000-abc' '20260101-000000-abc')"
_assert_eq "natural: newer date prefix is gt" "gt" \
  "$(_natural_tag_cmp '20260102-000000-abc' '20260101-000000-abc')"
_assert_eq "natural: older date prefix is lt" "lt" \
  "$(_natural_tag_cmp '20260100-000000-abc' '20260101-000000-abc')"

# Multi-digit numeric components: lexical would order `v1.10` BEFORE
# `v1.9` (wrong); natural order gives `v1.10` > `v1.9`. This is the
# parity gap with the Rust `compare_tags` implementation.
_assert_eq "natural: v1.10 is gt v1.9 (lexical would say lt)" "gt" \
  "$(_natural_tag_cmp 'v1.10' 'v1.9')"
_assert_eq "natural: v1.9 is lt v1.10" "lt" \
  "$(_natural_tag_cmp 'v1.9' 'v1.10')"
_assert_eq "natural: v2.0 is gt v1.99" "gt" \
  "$(_natural_tag_cmp 'v2.0' 'v1.99')"

# Leading zeros: 010 and 10 are equal numerically.
_assert_eq "natural: leading-zero numeric equals" "eq" \
  "$(_natural_tag_cmp 'v010' 'v10')"

# `v10` parses as Text("v"), Number("10") and `vbeta` parses as
# Text("vbeta"); the first comparison is Text("v") vs Text("vbeta")
# which resolves lexicographically (shorter prefix loses), so
# `v10` < `vbeta`. This is the documented Rust behavior — the
# cross-class "Number > Text" rule only fires when the two tags differ
# AT a Number-vs-Text boundary that is reached on both sides
# simultaneously (i.e., earlier parts compared equal).
_assert_eq "natural: differing first text runs decide before later parts" "lt" \
  "$(_natural_tag_cmp 'v10' 'vbeta')"
# Cross-class first runs: digit-first vs letter-first. This is the
# canonical case where the "Number > Text" rule applies because the
# parts compared at position 0 are different classes.
_assert_eq "natural: digit-first beats letter-first (Number > Text)" "gt" \
  "$(_natural_tag_cmp '1foo' 'afoo')"

# Tag with extra suffix is greater than the prefix.
_assert_eq "natural: longer-with-suffix is gt prefix" "gt" \
  "$(_natural_tag_cmp 'v1.0.1' 'v1.0')"

echo "=== install.sh: _release_tag_newer ==="

_assert_true "newer tag returns success" \
  _release_tag_newer "20260101-000000-abc" "20260100-000000-abc"
_assert_false "same tag returns failure" \
  _release_tag_newer "20260101-000000-abc" "20260101-000000-abc"
_assert_false "older latest returns failure" \
  _release_tag_newer "20260100-000000-abc" "20260101-000000-abc"
_assert_false "empty latest returns failure" \
  _release_tag_newer "" "20260101-000000-abc"
_assert_true "newer tag with multi-digit minor returns success" \
  _release_tag_newer "v1.10" "v1.9"

echo "=== install.sh: _refresh_release_install_if_stale guards ==="

# When the local install metadata is missing the `tag` field,
# `_refresh_release_install_if_stale` must NOT trigger a re-install on
# every shell startup. The pre-fix behavior fired `_install_release` on
# every call because `_release_tag_newer "$latest" ""` returned true; the
# guard inside the function short-circuits before the network step.
_install_release_called=0
_install_release() {
  # Stub: record invocation so the test can assert it never ran.
  _install_release_called=$((_install_release_called + 1))
  return 0
}
_latest_release_tag() {
  # Stub: pretend GitHub published a clearly-newer tag so any guard
  # failure would manifest as a recorded `_install_release` call.
  printf '20990101-000000-future\n'
}
_uses_default_repo_slug() { return 0; }
_repo_slug() { printf 'owner/repo\n'; }

_fixture_dir=$(mktemp -d)
trap 'rm -rf "$_fixture_dir"' EXIT
SHDEPS_DIR="$_fixture_dir/release-install"
mkdir -p "$SHDEPS_DIR"
touch "$SHDEPS_DIR/shdeps"
# A `.shdeps-install.json` with only `method` (no `tag`) — mirrors the
# corrupted-or-old state where the bug used to loop the download.
printf '{"method": "release"}\n' >"$SHDEPS_DIR/.shdeps-install.json"

_install_release_called=0
_refresh_release_install_if_stale
_assert_eq "missing tag does not fire install" "0" "$_install_release_called"

# Sanity check: with a valid older `tag`, the function DOES fire the
# install. This proves the guard is the only thing preventing the call.
printf '{"method": "release", "tag": "20260101-000000-abc"}\n' \
  >"$SHDEPS_DIR/.shdeps-install.json"
_install_release_called=0
_refresh_release_install_if_stale
_assert_eq "stale tag fires install" "1" "$_install_release_called"

echo "=== shdeps.sh: lazy ABI/env init ==="

# Source shdeps.sh in an isolated subshell with a synthetic binary that
# logs its invocations. The pre-fix code spawned two `__api` subprocesses
# at source time on every cold shell startup; the fix defers them to the
# first real `shdeps_*` call. Verifying the no-call-at-source-time
# property is the most direct way to pin the contract.
_lazy_dir=$(mktemp -d)
trap 'rm -rf "$_fixture_dir" "$_lazy_dir"' EXIT
cat >"$_lazy_dir/shdeps" <<EOF
#!/usr/bin/env bash
# Synthetic shdeps binary used by the lazy-init test. Logs each
# __api invocation so the test can count how often the wrapper
# spawned a subprocess.
printf '%s\n' "\$*" >>"$_lazy_dir/calls.log"
case "\$1 \$2" in
  '__api version') echo "abi:1" ;;
  '__api env-snapshot') echo "platform=linux" ;;
  '__api install-dir') echo "/tmp/install" ;;
  '__api bin-dir') echo "/tmp/bin" ;;
  *) echo "" ;;
esac
EOF
chmod +x "$_lazy_dir/shdeps"

_lazy_source_calls=$(
  : >"$_lazy_dir/calls.log"
  SHDEPS_RUST_CLI="$_lazy_dir/shdeps" \
    bash -c "source '$_repo_root/shdeps.sh' && wc -l <'$_lazy_dir/calls.log' | tr -d '[:space:]'"
)
_assert_eq "lazy init: zero subprocesses at source time" "0" "$_lazy_source_calls"

_lazy_call_calls=$(
  : >"$_lazy_dir/calls.log"
  SHDEPS_RUST_CLI="$_lazy_dir/shdeps" \
    bash -c "source '$_repo_root/shdeps.sh' && shdeps_install_dir >/dev/null && wc -l <'$_lazy_dir/calls.log' | tr -d '[:space:]'"
)
# After a single public-API call, both init subprocesses fire AND the
# install-dir lookup runs — that's 3 invocations. The exact number is
# not contract; what matters is "> 0", proving the deferred init ran.
_assert_true "lazy init: subprocesses fire on first public-API call" \
  test "$_lazy_call_calls" -gt 0

echo "=== install.sh: _curl_config_quote ==="

# The bearer token + URL are passed through `_curl_config_quote`
# before being embedded in `"..."`-quoted curl config fields.
# Escape contract: `\` → `\\`, `"` → `\"`. Plain alphanumerics
# pass through unchanged. Tokens from `gh auth token` are
# alphanumeric, but escaping is defensive against a malformed
# `SHDEPS_GH_TOKEN`.
_assert_eq "quote: alphanumeric passthrough" \
  "ghp_abc123XYZ" "$(_curl_config_quote 'ghp_abc123XYZ')"
_assert_eq 'quote: backslash doubled' \
  'a\\b' "$(_curl_config_quote 'a\b')"
_assert_eq 'quote: double-quote escaped' \
  'a\"b' "$(_curl_config_quote 'a"b')"
_assert_eq 'quote: backslash before quote order-correct' \
  'a\\\"b' "$(_curl_config_quote 'a\"b')"

echo "=== install.sh: _archive_entries_safe ==="

_archive_dir=$(mktemp -d)
trap 'rm -rf "$_fixture_dir" "$_lazy_dir" "$_archive_dir"' EXIT

# Safe archive: relative paths only.
_safe_archive="$_archive_dir/safe.tar.gz"
(
  cd "$_archive_dir"
  mkdir -p stage/bin stage/share/man/man1
  printf '#!/bin/sh\n' >stage/bin/shdeps
  printf '.TH SHDEPS 1\n' >stage/share/man/man1/shdeps.1
  tar -czf safe.tar.gz -C stage .
)
_assert_true "archive guard accepts a clean relative-path archive" \
  _archive_entries_safe "$_safe_archive"

# Hostile archive: absolute path. Use tar's --absolute-names where
# available; otherwise build via a tar member with a leading slash.
_evil_abs="$_archive_dir/evil-abs.tar.gz"
(
  cd "$_archive_dir"
  mkdir -p stage_abs/tmp
  printf 'evil\n' >stage_abs/tmp/file
  # tar normally strips leading slashes; use the -P flag (GNU) or
  # --absolute-paths (BSD) to preserve them. Fall back to a manual
  # path manipulation that the consumer-side `case` test catches.
  if tar --help 2>&1 | grep -q -- '--absolute-names'; then
    tar -czPf evil-abs.tar.gz /tmp/shdeps-test-evil-marker 2>/dev/null ||
      tar -czf evil-abs.tar.gz --transform 's,^,/abs/,' -C stage_abs tmp/file 2>/dev/null ||
      cp "$_safe_archive" evil-abs.tar.gz
  else
    cp "$_safe_archive" evil-abs.tar.gz
  fi
)
# If we built a real absolute-path archive above, the guard must refuse.
# If the tar flavor refused to build one, the test is a no-op (the
# `cp $_safe_archive` fallback would let the guard accept it), so guard
# only-fail when we can confirm the archive actually has an abs path.
if tar -tzf "$_evil_abs" 2>/dev/null | grep -qE '^/'; then
  _assert_false "archive guard refuses absolute-path entries" \
    _archive_entries_safe "$_evil_abs"
fi

# Hostile archive: `..` traversal in a path component.
_evil_dotdot="$_archive_dir/evil-dotdot.tar.gz"
(
  cd "$_archive_dir"
  mkdir -p stage_dd
  printf 'evil\n' >stage_dd/file
  # `tar --transform` (GNU) rewrites the member name to include `..`.
  if tar --help 2>&1 | grep -q -- '--transform'; then
    tar -czf evil-dotdot.tar.gz --transform 's,file,../escape,' -C stage_dd file
  else
    cp "$_safe_archive" evil-dotdot.tar.gz
  fi
)
if tar -tzf "$_evil_dotdot" 2>/dev/null | grep -qE '(^|/)\.\.(/|$)'; then
  _assert_false 'archive guard refuses dot-dot traversal entries' \
    _archive_entries_safe "$_evil_dotdot"
fi

echo "=== shdeps.sh: PATH fallback opt-in ==="

# The wrapper used to silently fall through to whatever `shdeps` happened
# to be on `$PATH`. In shared/CI environments that produced cryptic
# wrong-binary failures. The fallback is now opt-in via
# `SHDEPS_ALLOW_PATH_FALLBACK=1`. Verify both halves:
#   1) Without the env var, sourcing fails to find a binary when no
#      sibling/cargo build exists.
#   2) With the env var, the PATH binary is found.

_path_dir=$(mktemp -d)
cat >"$_path_dir/shdeps" <<EOF
#!/usr/bin/env bash
case "\$1 \$2" in
  '__api version') echo "abi:1" ;;
  '__api env-snapshot') echo "platform=linux" ;;
  *) echo "" ;;
esac
EOF
chmod +x "$_path_dir/shdeps"

# Stage a directory containing ONLY shdeps.sh (no sibling binary, no
# Cargo target tree) so the resolver falls through to the PATH branch.
_isolation_dir=$(mktemp -d)
cp "$_repo_root/shdeps.sh" "$_isolation_dir/shdeps.sh"

_path_default=$(
  # Use newline-separated commands so the echo runs regardless of
  # source's exit code. The earlier audit flagged a hypothetical
  # `&&` form that would silently skip the echo; this form is robust
  # against that. Also capture the source exit code separately so we
  # can assert source actually FAILED (a vacuous pass would be the
  # source succeeding with an empty `_SHDEPSW_BIN`).
  PATH="$_path_dir:/usr/bin:/bin" bash -c "
    source '$_isolation_dir/shdeps.sh' 2>/dev/null
    _src_rc=\$?
    echo \"BIN=\${_SHDEPSW_BIN:-NONE} SRC_RC=\$_src_rc\"
  " 2>/dev/null
)
_assert_eq "PATH fallback off by default: source fails AND BIN unset" \
  "BIN=NONE SRC_RC=1" "$_path_default"

_path_opted_in=$(
  PATH="$_path_dir:/usr/bin:/bin" SHDEPS_ALLOW_PATH_FALLBACK=1 \
    bash -c "
      source '$_isolation_dir/shdeps.sh'
      echo \"BIN=\$_SHDEPSW_BIN\"
    " 2>/dev/null
)
_assert_eq "PATH fallback honored with SHDEPS_ALLOW_PATH_FALLBACK=1" \
  "BIN=$_path_dir/shdeps" "$_path_opted_in"

rm -rf "$_path_dir" "$_isolation_dir"

echo ""
echo "================================"
echo "Results: $_pass_count passed, $_fail_count failed"
echo "================================"

if [[ $_fail_count -gt 0 ]]; then
  exit 1
fi
