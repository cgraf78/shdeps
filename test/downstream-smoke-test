#!/usr/bin/env bash
# downstream-smoke-test — local compatibility smoke for cgraf78 client repos.
#
# This is intentionally optional and local-only. The referenced repos are not
# part of the shdeps checkout, so CI cannot rely on them being present. When
# they are available under SHDEPS_CLIENT_REPO_ROOT (default: ~/git), this test
# verifies the contracts that matter for the Rust cutover: recent clients can
# still resolve sourceable/runtime assets through `shdeps dep-file`, and the
# sourceable wrapper resolves those same assets without falling back to a live
# installed shdeps.

set -uo pipefail

SHDEPS_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SHDEPS_RUST_CLI="${SHDEPS_RUST_CLI:-$SHDEPS_DIR/target/release/shdeps}"
if [[ ! -x "$SHDEPS_RUST_CLI" ]]; then
  SHDEPS_RUST_CLI="$SHDEPS_DIR/target/debug/shdeps"
fi

# shellcheck source=test/helpers.sh disable=SC1091
. "$(dirname "$0")/helpers.sh"

echo "=== Downstream client smoke ==="

if [[ ! -x "$SHDEPS_RUST_CLI" ]]; then
  printf 'error: no Rust shdeps binary found; run cargo build --release or set SHDEPS_RUST_CLI\n' >&2
  exit 2
fi

CLIENT_ROOT="${SHDEPS_CLIENT_REPO_ROOT:-$HOME/git}"

_client_specs=(
  "cgraf78/agentguard|agentguard|lib/agentguard/agentguard.sh"
  "cgraf78/sley|sley|share/sley/schemas/verify.schema.json"
  "cgraf78/termnav|termnav|lib/termnav/wezterm/link-routes.lua"
  "cgraf78/cmdblocks|cmdblocks|share/cmdblocks/shell.sh"
  "cgraf78/checkrun|checkrun|lib/checkrun/schemas/schema_policy.py"
)

_missing=()
for _spec in "${_client_specs[@]}"; do
  IFS='|' read -r _dep _repo _asset <<<"$_spec"
  [[ -d "$CLIENT_ROOT/$_repo" ]] || _missing+=("$CLIENT_ROOT/$_repo")
done

if [[ "${#_missing[@]}" -gt 0 ]]; then
  _pass "downstream smoke: skipped because local client repos are missing"
  for _repo in "${_missing[@]}"; do
    printf '    missing: %s\n' "$_repo" >&2
  done
  _test_summary
fi

_conf=$(_tmpdir)
_state=$(_tmpdir)
_install=$(_tmpdir)
_bin=$(_tmpdir)

# The smoke wants dependency resolution, not installation. A temp config keeps
# the public parser in the loop while bare github exercises the same local path
# resolver that shell hooks use after fleet configs ask shdeps to auto-pick
# release vs repo installs. The temp state intentionally has no manifest, so
# this pins the network-free fallback to already-cloned local repos.
for _spec in "${_client_specs[@]}"; do
  IFS='|' read -r _dep _repo _asset <<<"$_spec"
  printf '%s github\n' "$_dep"
done >"$_conf/deps.conf"

_run_with_temp_env() {
  SHDEPS_CONF_DIR="$_conf" \
    SHDEPS_STATE_DIR="$_state" \
    SHDEPS_INSTALL_DIR="$_install" \
    SHDEPS_BIN_DIR="$_bin" \
    SHDEPS_GIT_DEV_DIR="$CLIENT_ROOT" \
    SHDEPS_RUST_CLI="$SHDEPS_RUST_CLI" \
    "$@"
}

for _spec in "${_client_specs[@]}"; do
  IFS='|' read -r _dep _repo _asset <<<"$_spec"
  _expected="$CLIENT_ROOT/$_repo/$_asset"
  _actual=$(_run_with_temp_env "$SHDEPS_RUST_CLI" dep-file "$_dep" "$_asset" 2>&1)
  _assert_eq "downstream dep-file: $_dep $_asset" "$_expected" "$_actual"
done

_wrapper_output=$(
  # shellcheck disable=SC2016 # `$1` and loader vars must expand in the child shell.
  _run_with_temp_env bash -c '
    set -euo pipefail
    . "$1"
    shdeps_dep_file cgraf78/agentguard lib/agentguard/agentguard.sh
    shdeps_dep_source cgraf78/cmdblocks share/cmdblocks/shell.sh
    printf "cmdblocks-loaded=%s\n" "${CMDBLOCKS_SHELL_LOADED:-0}"
  ' bash "$SHDEPS_DIR/shdeps.sh"
)
_assert_contains "downstream wrapper: dep-file resolves agentguard" \
  "$CLIENT_ROOT/agentguard/lib/agentguard/agentguard.sh" "$_wrapper_output"
_assert_contains "downstream wrapper: dep-source sources cmdblocks shell asset" \
  "cmdblocks-loaded=1" "$_wrapper_output"

if [[ "${SHDEPS_DOWNSTREAM_RUN_SUITES:-0}" == "1" ]]; then
  # These suites are intentionally opt-in because they are broader client tests
  # and can be slow. Keeping this path here documents the exact environment
  # needed to prove the Rust binary is first on PATH without using live shdeps.
  for _spec in "${_client_specs[@]}"; do
    IFS='|' read -r _dep _repo _asset <<<"$_spec"
    _runner="$CLIENT_ROOT/$_repo/test/$_repo-test"
    if [[ -x "$_runner" ]]; then
      if PATH="${SHDEPS_RUST_CLI%/*}:$PATH" _run_with_temp_env "$_runner"; then
        _pass "downstream suite: $_repo"
      else
        _fail "downstream suite: $_repo"
      fi
    else
      _fail "downstream suite: missing $_runner"
    fi
  done
fi

_test_summary
